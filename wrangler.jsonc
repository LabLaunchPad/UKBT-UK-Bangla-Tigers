{
  // Cloudflare Workers static-assets deployment target for @ukbt/web.
  // See contracts/DEPLOYMENT-CONTRACT.md's 2026-08-27 amendment: HOST is
  // Cloudflare Workers (static assets), not Cloudflare Pages as originally
  // frozen — the owner connected this exact pre-provisioned Worker via the
  // Cloudflare dashboard's "Connect to a repository" flow on that date.
  //
  // AT REPOSITORY ROOT, deliberately, not in apps/web/. Cloudflare Workers
  // Builds runs its deploy command from the configured Root directory
  // ("/"), and wrangler looks for its config in the directory it runs
  // from. A config under apps/web/ is only found via an explicit
  // `-c apps/web/wrangler.jsonc` flag, which the dashboard's DEFAULT
  // deploy command does not pass — the real, logged cause of build
  // 55c1d854's "Missing entry-point to Worker script or to assets
  // directory". Keeping it here means `npx wrangler deploy` and
  // `npx wrangler versions upload` both work unmodified.
  //
  // No `main` entry: this is a pure static site (apps/web/astro.config.mjs
  // `output: 'static'`), so there is no Worker script to run — Cloudflare
  // serves `assets.directory` directly. Confirmed against Cloudflare's own
  // docs (developers.cloudflare.com/workers/framework-guides/web-apps/astro/,
  // "If you want to use Astro as a static site generator, you do not need
  // the Astro Cloudflare adapter").
  "name": "ukbt-uk-bangla-tigers",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "404-page"
  },
  // Mirrors the dashboard's current Observability settings for this Worker
  // (Settings > Observability), so `wrangler deploy`/`versions upload` from
  // CI don't silently reset them to defaults on the next deploy. Logs are
  // on; the top-level `enabled: false` and `traces.enabled: false` disable
  // the (separate, paid) Workers Logs/Traces *analytics engine* pipeline,
  // not `logs` itself.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
