---
// Foundation-stage layout. Per contracts/ROUTE-CONTRACT.md and
// contracts/SEO-CONTRACT.md, no metadata pipeline is wired yet — this is
// literal placeholder markup proving the build/CSS pipeline executes, not
// a real page. No UKBT organizational fact appears anywhere below.
//
// Generated by Style Dictionary from packages/truth/tokens/approved/ —
// gitignored, never hand-edited (contracts/CSS-CONTRACT.md,
// contracts/REPOSITORY-CONTRACT.md's generated-code policy). Produced by
// `pnpm build` (root script runs tokens:build before the Astro build).
import '../styles/generated/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  structuredData?: Record<string, unknown>;
  /**
   * Keep the page out of search results. Required by
   * `contracts/ROUTE-CONTRACT.md` Amendment 01 condition 2 for the
   * commerce-shaped shells (`/services`, `/membership`, `/join`): their
   * structure is built, but UKBT has no evidence it offers those things,
   * and an indexed page is a public claim that it does.
   */
  noindex?: boolean;
}
const { title, description, structuredData, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content="/social-card.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content="/social-card.jpg" />

    {
      structuredData && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
