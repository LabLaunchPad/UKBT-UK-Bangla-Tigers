---
// Club Captain page â€” the one full player profile actually evidenced
// (artifacts/content/UKBT-CONTENT-INVENTORY.md C-003/C-005/C-006/C-007/
// C-008). No Adelux template page maps to a player-stats profile, so
// ProfileHeader/StatsTable are UKBT-original (see their own comments).
// Stats-provider platform names are evidenced; their profile URLs are
// client-supplied (see captain-data.ts) and rendered as external links.
// Personal-social platform names remain plain text (no URLs supplied).
// PageBanner carries the page h1; ProfileHeader's name renders as h2.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Section from '../components/Section.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import StatsTable from '../components/StatsTable.astro';
import Footer from '../components/Footer.astro';
import { homepage } from '../content/homepage-data';
import { captain, captainPhoto } from '../content/captain-data';
import { captainGraph } from '../lib/seo';

const profileFacts = [
  { label: 'Date of Birth', value: captain.dob },
  { label: 'Nationality', value: captain.nationality },
  { label: 'Batting Style', value: captain.battingStyle },
  { label: 'Bowling Style', value: captain.bowlingStyle },
];

const battingHeaders = ['Format', 'M', 'Inn', 'Runs', 'HS', 'Avg', 'SR', '100s', '50s'];
const battingRows = captain.battingStats.map((s) => [
  s.format,
  s.matches,
  s.innings,
  s.runs,
  s.highScore,
  s.average,
  s.strikeRate,
  s.hundreds,
  s.fifties,
]);

const bowlingHeaders = ['Format', 'Overs', 'Wkts', 'Avg', 'Econ', 'Best'];
const bowlingRows = captain.bowlingStats.map((s) => [
  s.format,
  s.overs,
  s.wickets,
  s.average,
  s.economy,
  s.best,
]);

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Club Captain' }];
// ProfilePage+Person graph via the central SEO emitter — gated name/role
// only (see src/lib/seo.ts).
const structuredData = captainGraph({
  name: captain.name,
  role: captain.role,
  photo: captainPhoto,
  crumbs,
});
---

<BaseLayout
  title="Club Captain â€” UK Bangla Tigers"
  description={`${captain.name}, ${captain.role}`}
  structuredData={structuredData}
>
  <Header nav={homepage.nav} cta={homepage.primaryCta} />

  <main id="main-content" tabindex="-1">
    <PageBanner title="Club Captain" crumbs={crumbs} />

    <Section>
      <ProfileHeader name={captain.name} role={captain.role} facts={profileFacts} photo={captainPhoto} />
    </Section>

    <Section surface="alt">
      <h2>Franchise History</h2>
      <div class="ukbt-franchise-history">
        <div class="ukbt-franchise-history__col">
          <h3>Current</h3>
          <ul>
            {captain.currentFranchises.map((f) => <li>{f}</li>)}
          </ul>
        </div>
        <div class="ukbt-franchise-history__col">
          <h3>Previous</h3>
          <ul>
            {captain.previousFranchises.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </div>
    </Section>

    <Section>
      <h2>Career Statistics</h2>
      <div class="ukbt-stats-stack">
        <StatsTable caption="Batting" headers={battingHeaders} rows={battingRows} />
        <StatsTable caption="Bowling" headers={bowlingHeaders} rows={bowlingRows} />
      </div>
    </Section>

    <Section surface="alt" paddingBottom="normal">
      <div class="ukbt-links-grid">
        <div>
          <h3>Stats Also Tracked On</h3>
          <ul class="ukbt-plain-list">
            {captain.statsProviders.map((p) => (
              <li><a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Follow {captain.name}</h3>
          <ul class="ukbt-plain-list">
            {captain.personalSocialPlatforms.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </div>
    </Section>
  </main>

  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>

<style>
  h2 {
    margin: 0 0 var(--ukbt-space-gap-5) 0;
  }
  h3 {
    margin: 0 0 var(--ukbt-space-gap-2) 0;
  }
  .ukbt-franchise-history {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ukbt-space-8);
  }
  .ukbt-franchise-history__col {
    border-top: 2px solid var(--ukbt-color-brand-accent);
    padding-top: var(--ukbt-space-4);
  }
  .ukbt-franchise-history ul {
    margin: 0;
    padding-left: var(--ukbt-space-4);
    color: var(--ukbt-color-neutral-700);
  }
  .ukbt-stats-stack {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-8);
  }
  .ukbt-links-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ukbt-space-8);
  }
  .ukbt-plain-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-2);
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-size-0);
  }
  .ukbt-plain-list a {
    color: var(--ukbt-color-brand-primary);
    text-decoration: underline;
    text-decoration-color: var(--ukbt-color-neutral-300);
    transition: text-decoration-color 0.2s;
  }
  .ukbt-plain-list a:hover {
    text-decoration-color: var(--ukbt-color-brand-primary);
  }
  .ukbt-plain-list a:focus-visible {
    outline: 2px solid var(--ukbt-color-brand-accent);
    outline-offset: 2px;
  }

  @media (max-width: 767px) {
    .ukbt-franchise-history,
    .ukbt-links-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
