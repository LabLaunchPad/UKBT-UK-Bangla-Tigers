---
// Uppsala Tigers franchise detail page â€” moved here from the single-page
// /franchises showcase (which is now the Our Franchises card-grid
// landing) per the client's instruction that this franchise sit under a
// clickable "Our Franchise" list (EV-20260831-001, EV-20260831-002;
// contracts/ROUTE-CONTRACT.md AMENDMENT 02). Full squad + team officials
// per the club's own "Uppsala Tigers Players & Managements List"
// (EV-20260831-005/-006), superseding the earlier overseas-only roster.
// "Nipo Khadem" excluded per CLIENT_REQ_008 â€” absent from every squad
// list supplied since that instruction.
//
// The intro image is Uppsala Tigers' own supplied crest
// (EV-20260831-004), not nordic-smash-slide.webp: that graphic has "NIPO
// KHADEM / PORTUGAL" baked into the photo itself (EV-20260826-031, found
// on direct visual inspection of this page's own screenshot) â€” no
// text-content check can catch a name inside a raster image. No
// alternative photo excluding that player exists in evidence.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import PageBanner from '../../components/PageBanner.astro';
import Section from '../../components/Section.astro';
import RosterGrid from '../../components/RosterGrid.astro';
import Footer from '../../components/Footer.astro';
import { homepage } from '../../content/homepage-data';
import {
  ourFranchises,
  uppsalaFacts,
  uppsalaOfficials,
  uppsalaSquad,
} from '../../content/franchises-data';
import SubHeading from '../../components/SubHeading.astro';

const uppsala = ourFranchises.find((f) => f.slug === 'uppsala-tigers');
if (!uppsala) {
  throw new Error("franchises-data.ts's ourFranchises is missing 'uppsala-tigers'");
}
---

<BaseLayout
  title="Uppsala Tigers â€” Our Franchises â€” UK Bangla Tigers"
  description="UK Bangla Tigers' sister franchise, Uppsala Tigers (Sweden)."
>
  <Header nav={homepage.nav} cta={homepage.primaryCta} />

  <main id="main-content" tabindex="-1">
    <PageBanner
      title="Uppsala Tigers"
      crumbs={[
        { label: 'Home', href: '/' },
        { label: 'Our Franchises', href: '/franchises' },
        { label: 'Uppsala Tigers' },
      ]}
    />

    <Section>
      <div class="ukbt-franchise-intro">
        <div class="ukbt-franchise-intro__crest-panel">
          <img src={uppsala.logo} width="220" height="220" alt={uppsala.logoAlt} />
        </div>
        <div>
          <SubHeading label="Sister Franchise" />
          <h2>Uppsala Tigers, Sweden</h2>
          <ul class="ukbt-franchise-intro__facts">
            {
              uppsalaFacts.map((f) => (
                <li>
                  <h3>{f.title}</h3>
                  <p>{f.body}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </Section>

    <Section surface="alt">
      <h2>Squad</h2>
      <RosterGrid players={uppsalaSquad} />
    </Section>

    <Section paddingBottom="normal">
      <h2>Team Officials</h2>
      <ul class="ukbt-officials-list">
        {
          uppsalaOfficials.map((o) => (
            <li>
              {o.photo && (
                <img
                  class="ukbt-officials-list__photo"
                  src={o.photo}
                  alt={o.photoAlt ?? `${o.name} â€” Uppsala Tigers ${o.role}`}
                  width="64"
                  height="64"
                />
              )}
              <div>
                <span class="ukbt-officials-list__role">{o.role}</span>
                <span class="ukbt-officials-list__name">{o.name}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </Section>
  </main>

  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>

<style>
  h2 {
    margin: var(--ukbt-space-gap-2) 0 var(--ukbt-space-gap-5) 0;
  }
  /* .community-grid: grid-template-columns 1fr 1fr, gap 100px */
  .ukbt-franchise-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ukbt-space-gap-100);
    align-items: center;
  }
  .ukbt-franchise-intro__crest-panel {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ukbt-color-surface-alt);
    border-radius: var(--ukbt-radius-lg);
    padding: var(--ukbt-space-8) var(--ukbt-space-4);
  }
  .ukbt-franchise-intro__crest-panel img {
    display: block;
    height: 14rem;
    width: auto;
  }
  .ukbt-franchise-intro__facts {
    list-style: none;
    margin: var(--ukbt-space-4) 0 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-4);
  }
  .ukbt-franchise-intro__facts h3 {
    margin: 0;
    font-size: var(--ukbt-font-size-1);
  }
  .ukbt-franchise-intro__facts p {
    margin: 0;
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-size-0);
  }

  /* Reference `.community-grid` collapses to a single column at <=1025px. */
  @media screen and (max-width: 1025px) {
    .ukbt-franchise-intro {
      grid-template-columns: 1fr;
      gap: var(--ukbt-space-gap-5);
    }
  }

  .ukbt-officials-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: var(--ukbt-space-4);
  }
  .ukbt-officials-list li {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--ukbt-space-3);
    background: var(--ukbt-color-surface-alt);
    border-radius: var(--ukbt-radius-lg);
    padding: var(--ukbt-space-4);
    border-top: 3px solid var(--ukbt-color-brand-accent);
  }
  .ukbt-officials-list li > div {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-1);
  }
  .ukbt-officials-list__photo {
    flex: none;
    width: 4rem;
    height: 4rem;
    border-radius: var(--ukbt-radius-ref-circle);
    object-fit: cover;
    object-position: top center;
    background: var(--ukbt-color-surface);
  }
  .ukbt-officials-list__role {
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-700);
  }
  .ukbt-officials-list__name {
    font-weight: var(--ukbt-font-weight-bold);
  }
</style>
