---
// Players Profile page. The full 42-name roster is real evidence
// (EV-20260831-005). 19 of the 42 (the ones who also play for Uppsala
// Tigers) now have a photo too (EV-20260831-008, reused from that same
// squad's photography â€” same person, same photo). Individual full
// profiles (bio, stats) beyond the Club Captain remain UNKNOWN and are
// stated as such rather than invented; per CLIENT_REQ_006 the roster
// renders name + country (+ photo where supplied) and no stats table.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Section from '../components/Section.astro';
import CaptainSpotlight from '../components/CaptainSpotlight.astro';
import RosterGrid from '../components/RosterGrid.astro';
import Footer from '../components/Footer.astro';
import { homepage } from '../content/homepage-data';
import { captain } from '../content/captain-data';
import { fullRoster } from '../content/players-data';
---

<BaseLayout
  title="Players Profile â€” UK Bangla Tigers"
  description="UK Bangla Tigers player profiles."
>
  <Header nav={homepage.nav} cta={homepage.primaryCta} />

  <main id="main-content" tabindex="-1">
    <PageBanner
      title="Players Profile"
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Players Profile' }]}
    />

    <Section>
      <div class="ukbt-players-stat">
        <span class="ukbt-players-stat__value">{homepage.stats.players}</span>
        <span class="ukbt-players-stat__label">Players across the squad</span>
      </div>
      <CaptainSpotlight name={captain.name} role={captain.role} />
    </Section>

    <Section surface="alt">
      <h2>Squad</h2>
      <RosterGrid players={fullRoster} />
    </Section>

    <Section paddingBottom="normal">
      <p class="ukbt-players-note">
        Full individual profiles (biography, career statistics, photo) for
        the rest of the squad are being confirmed with the club and will be
        published here as they're ready. The Club Captain's full profile is
        available now.
      </p>
    </Section>
  </main>

  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>

<style>
  h2 {
    margin: 0 0 var(--ukbt-space-gap-5) 0;
  }
  .ukbt-players-stat {
    display: flex;
    align-items: baseline;
    gap: var(--ukbt-space-3);
    margin-bottom: var(--ukbt-space-8);
  }
  .ukbt-players-stat__value {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-5);
    font-weight: var(--ukbt-font-weight-bold);
    color: var(--ukbt-color-brand-primary);
  }
  .ukbt-players-stat__label {
    color: var(--ukbt-color-neutral-700);
  }
  .ukbt-players-note {
    margin: 0;
    color: var(--ukbt-color-neutral-700);
    max-width: 42rem;
  }
</style>
