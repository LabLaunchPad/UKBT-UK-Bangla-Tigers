---
// Design-system visual test page (Stage 5, prompts/15-design-system.md:
// "Build a visual test page exercising the tokens and components"). This
// is infrastructure for verification, not a real UKBT route — it carries
// no organizational content and is not part of the site's information
// architecture (contracts/ROUTE-CONTRACT.md).
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';

const typeScale = [0, 1, 2, 3, 4, 5, 6] as const;
const neutralSteps = [0, 50, 100, 300, 500, 700, 900] as const;
---

<BaseLayout title="UKBT Design System — Foundation verification">
  <main class="ukbt-container">
    <h1>UKBT Design System</h1>
    <p>Foundation-stage verification page. Not a real route.</p>

    <section aria-labelledby="type-scale-heading">
      <h2 id="type-scale-heading">Type scale</h2>
      {
        typeScale.map((step) => (
          <p style={`font-size: var(--ukbt-font-size-${step}); margin: 0.25rem 0;`}>
            font-size-{step}: The quick brown fox
          </p>
        ))
      }
    </section>

    <section aria-labelledby="color-heading">
      <h2 id="color-heading">Neutral scale</h2>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        {
          neutralSteps.map((step) => {
            // Real WCAG contrast check per step (packages/truth/src/tokens/approved/README.md's
            // methodology, applied here too): steps >= 500 need white label
            // text to clear 4.5:1 against their own background; below that,
            // black passes. Found by an actual axe-core failure on this
            // page, not anticipated in advance — fixed, not suppressed.
            const labelColor = step >= 500 ? '#ffffff' : '#000000';
            return (
              <div
                style={`width: 4rem; height: 4rem; border-radius: var(--ukbt-radius-md); border: 1px solid var(--ukbt-color-neutral-300); background: var(--ukbt-color-neutral-${step}); display: flex; align-items: center; justify-content: center; font-size: 0.7rem; color: ${labelColor};`}
              >
                {step}
              </div>
            );
          })
        }
      </div>

      <h3>Feedback colors</h3>
      <div style="display: flex; gap: var(--ukbt-space-4);">
        <span style="color: var(--ukbt-color-feedback-danger);">danger text</span>
        <span style="color: var(--ukbt-color-feedback-success);">success text</span>
        <span style="color: var(--ukbt-color-feedback-warning);">warning text</span>
      </div>
    </section>

    <section aria-labelledby="button-heading">
      <h2 id="button-heading">Button — variants and states</h2>
      <div style="display: flex; gap: var(--ukbt-space-4); flex-wrap: wrap; align-items: center;">
        <Button label="Primary" variant="primary" />
        <Button label="Secondary" variant="secondary" />
        <Button label="Danger" variant="danger" />
        <Button label="Disabled" variant="primary" disabled />
        <Button label="Link button" variant="primary" href="#card-heading" />
      </div>
      <p>Tab to each button above to verify the visible focus ring.</p>
    </section>

    <section aria-labelledby="card-heading">
      <h2 id="card-heading">Card — static and linked</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--ukbt-space-6);">
        <Card heading="Static card" body="No href — not interactive, no hover/focus state." />
        <Card heading="Linked card" body="The whole card is one focusable, hoverable link." href="#type-scale-heading" />
      </div>
    </section>

    <section aria-labelledby="spacing-heading">
      <h2 id="spacing-heading">Spacing scale</h2>
      {
        ([1, 2, 3, 4, 6, 8] as const).map((step) => (
          <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.25rem;">
            <span style="width: 6rem; font-size: 0.8rem;">space-{step}</span>
            <div style={`width: var(--ukbt-space-${step}); height: 1rem; background: var(--ukbt-color-neutral-700);`} />
          </div>
        ))
      }
    </section>
  </main>
</BaseLayout>
