---
// About Us page â€” implements artifacts/pages/ABOUT-CONTRACT.md. Content
// bound to @ukbt/truth's gate (src/content/about-data.ts); shared nav/
// social come from homepage-data.ts so they are gated exactly once.
// Each section's geometry mirrors the reference's actual measured layout
// (checked directly against the Adelux `about.html`/`main.css` source â€”
// see per-component comments), reimplemented with UKBT content/branding.
// No Adelux code, content, or branding appears anywhere below.
//
// Sponsors section (EV-20260831-007) reinstates the reference's
// partner-logo panel (`.partnership-container`) right where
// MissionWelcome.astro's own header comment noted its omission "no
// sponsor is evidenced" â€” now one is.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Section from '../components/Section.astro';
import MissionWelcome from '../components/MissionWelcome.astro';
import Sponsors from '../components/Sponsors.astro';
import AboutStory from '../components/AboutStory.astro';
import FounderSpotlight from '../components/FounderSpotlight.astro';
import LeadershipGrid from '../components/LeadershipGrid.astro';
import AboutCTA from '../components/AboutCTA.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Footer from '../components/Footer.astro';
import { homepage } from '../content/homepage-data';
import { about } from '../content/about-data';
import { ourSponsors } from '../content/sponsors-data';
import { aboutGraph } from '../lib/seo';

// Restates facts already on record; no new claim about the club.
const reasons = [
  {
    title: 'International Competition',
    body: 'Competing across the Safari International T20 Cup, Nordic Smash T20 and the Asian Challengers Trophy.',
  },
  {
    title: 'A Learning Institute',
    body: 'The club describes itself as not only a team, but an institute for learning.',
  },
  {
    title: 'A Franchise Network',
    body: 'One family across two nations, alongside sister franchise Uppsala Tigers in Sweden.',
  },
  {
    title: 'A Registered Club',
    body: `Founded in ${about.founded} · registered as ${about.legalEntity}.`,
  },
];

const storyStats = [
  { value: about.founded, label: 'Founded' },
  { value: about.stats.players, label: 'Players' },
  { value: about.stats.tournaments, label: 'International Tournaments' },
];

// About Phase 1 (legacy S2 port): founder career aggregates. Distinct
// fields from the club aggregates above (career matches, active subset
// of the registered squad) — no T8 conflict by construction. Per
// EV-20260910-003 both the club aggregate and the active subset read 40+
// (growth, not a conflict); labels and sections stay distinct.
const founderStats = [
  { value: about.founder.stats.careerMatches, label: 'Career Matches' },
  { value: about.founder.stats.activePlayers, label: 'Active Players' },
];

const crumbs = [{ label: 'Home', href: '/' }, { label: 'About Us' }];
// AboutPage graph via the central SEO emitter — org referenced by @id,
// never repeated (see src/lib/seo.ts).
const structuredData = aboutGraph({
  description: about.tagline,
  crumbs,
});
---

<BaseLayout
  title="About Us â€” UK Bangla Tigers"
  description={about.tagline}
  structuredData={structuredData}
>
  <Header nav={homepage.nav} cta={homepage.primaryCta} />

  <main id="main-content" tabindex="-1">
    <PageBanner title="About Us" crumbs={crumbs} lede={about.heroSubline} />

    <Section density="compact">
      <MissionWelcome tagline={about.tagline} facts={about.missionFacts} />
    </Section>

    <Section surface="alt" wrapper={true} density="compact">
      <Sponsors sponsors={ourSponsors} />
    </Section>

    <Section density="compact">
      <AboutStory paragraphs={about.storyParagraphs} stats={storyStats} />
    </Section>

    <Section density="compact">
      <FounderSpotlight
        image={about.founder.image}
        cardTitle="Founder of UK Bangla Tigers, competing at the Safari International T20 Cup."
        eyebrow="Founder Spotlight"
        heading="Mohammad Chowdhury, Founder and CEO."
        paragraphs={about.founder.story}
        stats={founderStats}
      />
    </Section>

    <Section surface="alt" wrapper={true} density="compact">
      <WhyChooseUs reasons={reasons} variant="editorial" />
    </Section>

    <Section density="compact">
      <LeadershipGrid
        leaders={about.leaders}
        narrative={about.managementStory}
        graphic={about.leadershipGraphic}
        spotlight={about.sayem}
      />
    </Section>

    <!-- TestimonialSection omitted: no real testimonials exist yet -->

    <Section surface="alt" paddingBottom="normal" density="compact">
      <AboutCTA social={homepage.social} />
    </Section>
  </main>

  <Footer social={homepage.social} nav={homepage.nav} secondaryNav={homepage.secondaryNav} />
</BaseLayout>
