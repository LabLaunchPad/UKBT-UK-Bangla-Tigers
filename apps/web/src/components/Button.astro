---
// Layer 7 adapter for packages/truth/src/contracts/button.contract.md.
// UKBT-original primitive — no Adelux-derived DOM shape or styling.
interface Props {
  label: string;
  variant?: 'primary' | 'secondary' | 'danger';
  disabled?: boolean;
  href?: string;
}

const { label, variant = 'primary', disabled = false, href } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class={`ukbt-button ukbt-button--${variant}`}
  href={href}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
>
  {label}
</Tag>

<style>
  .ukbt-button {
    display: inline-block;
    padding: var(--ukbt-space-2) var(--ukbt-space-4);
    border: 1px solid var(--ukbt-color-surface-foreground);
    border-radius: var(--ukbt-radius-md);
    background: var(--ukbt-color-surface-background);
    color: var(--ukbt-color-surface-foreground);
    font: inherit;
    font-weight: var(--ukbt-font-weight-medium);
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--ukbt-motion-duration-base) var(--ukbt-motion-easing-standard);
  }

  .ukbt-button--secondary {
    background: transparent;
  }

  .ukbt-button--danger {
    border-color: var(--ukbt-color-feedback-danger);
    color: var(--ukbt-color-feedback-danger);
  }

  .ukbt-button:hover {
    background: var(--ukbt-color-neutral-100);
  }

  .ukbt-button--danger:hover {
    background: var(--ukbt-color-feedback-danger);
    color: var(--ukbt-color-neutral-0);
  }

  /* :focus-visible base rule lives globally in styles/base.css; this only
     adds the button-specific offset so the ring clears the border. */
  .ukbt-button:focus-visible {
    outline-offset: 3px;
  }

  .ukbt-button[disabled],
  .ukbt-button[aria-disabled='true'] {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
