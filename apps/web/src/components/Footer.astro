---
// Footer with icon-only social links (CLIENT_REQ_004: "Use the symbols
// only and connect using the links" — no text labels). Inline SVG icons,
// not a new icon-library dependency (none was actually installed —
// corrects an earlier assumption in HOMEPAGE-TEMPLATE-MAPPING.md).
interface SocialLink {
  platform: string;
  url: string;
}
interface Props {
  social: SocialLink[];
  nav: { label: string; href: string }[];
}
const { social, nav } = Astro.props;

const icons: Record<string, string> = {
  facebook: 'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12',
  instagram: 'M12 2c2.7 0 3.1 0 4.1.1 1.1 0 1.8.2 2.5.5.7.3 1.2.6 1.7 1.1.5.5.9 1 1.1 1.7.3.7.5 1.4.5 2.5.1 1 .1 1.4.1 4.1s0 3.1-.1 4.1c0 1.1-.2 1.8-.5 2.5-.3.7-.6 1.2-1.1 1.7-.5.5-1 .9-1.7 1.1-.7.3-1.4.5-2.5.5-1 .1-1.4.1-4.1.1s-3.1 0-4.1-.1c-1.1 0-1.8-.2-2.5-.5-.7-.3-1.2-.6-1.7-1.1-.5-.5-.9-1-1.1-1.7-.3-.7-.5-1.4-.5-2.5C2 15.1 2 14.7 2 12s0-3.1.1-4.1c0-1.1.2-1.8.5-2.5.3-.7.6-1.2 1.1-1.7.5-.5 1-.9 1.7-1.1.7-.3 1.4-.5 2.5-.5C8.9 2 9.3 2 12 2Zm0 2c-2.6 0-3 0-4 .1-.9 0-1.4.2-1.7.3-.4.2-.7.4-1 .7-.3.3-.5.6-.7 1-.1.3-.3.8-.3 1.7C4.2 9 4.2 9.4 4.2 12s0 3 .1 4c0 .9.2 1.4.3 1.7.2.4.4.7.7 1 .3.3.6.5 1 .7.3.1.8.3 1.7.3 1 .1 1.4.1 4 .1s3 0 4-.1c.9 0 1.4-.2 1.7-.3.4-.2.7-.4 1-.7.3-.3.5-.6.7-1 .1-.3.3-.8.3-1.7.1-1 .1-1.4.1-4s0-3-.1-4c0-.9-.2-1.4-.3-1.7-.2-.4-.4-.7-.7-1-.3-.3-.6-.5-1-.7-.3-.1-.8-.3-1.7-.3-1-.1-1.4-.1-4-.1Zm0 3.5A4.5 4.5 0 1 1 12 16a4.5 4.5 0 0 1 0-9Zm0 2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Zm4.8-2.7a1 1 0 1 1 0 2.1 1 1 0 0 1 0-2.1Z',
  tiktok: 'M14 2h3a5 5 0 0 0 5 5v3a8 8 0 0 1-5-1.7V15a6 6 0 1 1-6-6c.3 0 .7 0 1 .1v3.1a3 3 0 1 0 2 2.8V2Z',
  x: 'M3 3l7.4 9.5L3.2 21H6l5.7-6.4L16 21h5l-7.7-9.9L20.6 3h-2.8l-5.3 5.9L8 3H3Z',
};
---

<footer class="ukbt-footer">
  <div class="ukbt-container ukbt-footer__inner">
    <nav aria-label="Footer">
      <ul class="ukbt-footer__nav">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <ul class="ukbt-footer__social" aria-label="UK Bangla Tigers on social media">
      {
        social.map((link) => (
          <li>
            <a href={link.url} aria-label={`UK Bangla Tigers on ${link.platform}`} rel="me noopener">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
                <path d={icons[link.platform]} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="ukbt-footer__copyright">&copy; {new Date().getFullYear()} UK Bangla Tigers</p>
  </div>
</footer>

<style>
  .ukbt-footer {
    background: var(--ukbt-color-surface-inverse);
    color: var(--ukbt-color-surface-inverse-foreground);
  }
  .ukbt-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ukbt-space-4);
    padding-block: var(--ukbt-space-8);
    text-align: center;
  }
  .ukbt-footer__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--ukbt-space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ukbt-footer__nav a {
    color: inherit;
    text-decoration: none;
    font-size: var(--ukbt-font-size-0);
    opacity: 0.9;
  }
  .ukbt-footer__nav a:hover {
    color: var(--ukbt-color-brand-accent);
  }
  .ukbt-footer__social {
    display: flex;
    gap: var(--ukbt-space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ukbt-footer__social a {
    color: var(--ukbt-color-surface-inverse-foreground);
    display: inline-flex;
  }
  .ukbt-footer__social a:hover {
    color: var(--ukbt-color-brand-accent);
  }
  .ukbt-footer__copyright {
    font-size: var(--ukbt-font-size-0);
    opacity: 0.7;
    margin: 0;
  }
  .ukbt-footer a:focus-visible {
    outline: 2px solid var(--ukbt-color-brand-accent);
    outline-offset: 2px;
  }
</style>
