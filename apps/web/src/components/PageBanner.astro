---
// Inner-page title banner — mirrors the reference's real
// `.section-banner-inner` pattern (large top padding, rounded corners,
// centered title + breadcrumb over a tinted surface). Reusable across
// every inner page (About, Club Captain, etc.), not About-specific.
interface Crumb {
  label: string;
  href?: string;
}
import Breadcrumb from './Breadcrumb.astro';

interface Props {
  title: string;
  crumbs: Crumb[];
  lede?: string;
  /* Optional photographic backdrop (About banner, owner direction
     2026-09-11). Absent everywhere else — default preserves the plain
     navy rendering on all other pages. When present, a token-native
     navy shade keeps the gold-on-dark contrast posture identical. */
  background?: {
    src: string;
    alt: string;
    width: number;
    height: number;
  };
}
const { title, crumbs, lede, background } = Astro.props;
---

<div class="ukbt-page-banner">
  {background && (
    <img
      class="ukbt-page-banner__bg"
      src={background.src}
      alt={background.alt}
      width={background.width}
      height={background.height}
      fetchpriority="high"
      decoding="async"
    />
    <div class="ukbt-page-banner__shade" aria-hidden="true" />
  )}
  <div class="ukbt-container ukbt-page-banner__inner">
    <h1>{title}</h1>
    {lede && <p class="ukbt-page-banner__lede">{lede}</p>}
    <Breadcrumb crumbs={crumbs} tone="on-dark" />
  </div>
</div>

<style>
  /* Reference `.section-banner-inner`: padding 230px top / 120px bottom,
     30px radius, sat inside a 30px `.section-wrapper` inset. The large top
     value is what gives inner pages their proportion — it clears the fixed
     header and leaves the title optically centred in the band. */
  .ukbt-page-banner {
    background: var(--ukbt-color-surface-inverse);
    color: var(--ukbt-color-surface-inverse-foreground);
    border-radius: var(--ukbt-radius-ref-banner);
    margin-inline: var(--ukbt-space-section-wrapper);
    margin-block-start: var(--ukbt-space-section-wrapper);
    /* Clips the optional photographic backdrop to the 30px radius.
       No positioned-overflow children (breadcrumb links are static),
       so clipping is safe. */
    position: relative;
    overflow: hidden;
    isolation: isolate;
    /* Dark navy surface: the global :focus-visible fallback
       (CanvasText, ~1.25:1 on navy — F3) would be invisible here, so
       repaint the ring gold for all focusable descendants. */
    --ukbt-color-focus-ring: var(--ukbt-color-brand-accent);
  }
  /* Backdrop treatment (only rendered when `background` is passed):
     cover-cropped photo, then a solid token-navy shade at fixed
     opacity — token-native, no literals — so the gold title, white
     lede and breadcrumb keep exactly the plain-navy contrast posture.
     Content sits above via its own stacking (inner is positioned). */
  .ukbt-page-banner__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }
  .ukbt-page-banner__shade {
    position: absolute;
    inset: 0;
    background: var(--ukbt-color-surface-inverse);
    opacity: 0.84;
    z-index: 1;
  }
  .ukbt-page-banner__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ukbt-space-gap-2);
    text-align: center;
    padding-block: var(--ukbt-space-banner-padding-top)
      var(--ukbt-space-banner-padding-bottom);
    /* Above-fold load entrance: single fade-up, no stagger — inner pages
       open settled, not staged. Finite, once. */
    animation: ukbt-banner-in var(--ukbt-motion-duration-slow)
      var(--ukbt-motion-easing-emphasized) backwards;
  }
  @keyframes ukbt-banner-in {
    from {
      opacity: 0;
      transform: translateY(var(--ukbt-motion-distance-sm));
    }
  }
  .ukbt-page-banner h1 {
    font-family: var(--ukbt-font-family-heading);
    color: var(--ukbt-color-brand-accent);
    margin: 0;
    /* Long titles wrapped mid-word at 390px (render-verified) — balance
       keeps phrases together instead. */
    text-wrap: balance;
    /* A centred column-flex child sizes to max-content and can exceed its
       parent, which leaves `overflow-wrap` with nothing to break against.
       Constraining the width is what actually lets long titles wrap —
       "International Tournaments/Events" measured 546px against a 430px
       viewport without this. */
    max-width: 100%;
  }
  .ukbt-page-banner__lede {
    margin: 0;
    max-width: 44rem;
    color: var(--ukbt-color-surface-inverse-foreground);
    font-size: var(--ukbt-font-size-1);
    text-wrap: balance;
  }
  /* Reference parity holds at desktop/tablet. On mobile the 230px top
     padding delays content by nearly half a viewport — step down to
     a proportion that still clears the fixed header. */
  @media screen and (max-width: 1025px) {
    .ukbt-page-banner {
      margin-inline: var(--ukbt-space-section-wrapper-md);
      margin-block-start: var(--ukbt-space-section-wrapper-md);
    }
    .ukbt-page-banner__inner {
      padding-block: 140px var(--ukbt-space-banner-padding-bottom);
    }
  }
  @media screen and (max-width: 767px) {
    .ukbt-page-banner {
      margin-inline: var(--ukbt-space-section-wrapper-sm);
      margin-block-start: var(--ukbt-space-section-wrapper-sm);
    }
    .ukbt-page-banner__inner {
      padding-block: 100px 80px;
    }
    /* Fluid display size below tablet: at 767px it computes to ~49px
       (seamless with the desktop 50px), shrinking to ~36px at 390px so
       long words like "International" fit their box instead of splitting
       mid-word under overflow-wrap. Token-native, no literals. */
    .ukbt-page-banner h1 {
      font-size: var(--ukbt-font-size-display);
    }
  }
</style>
