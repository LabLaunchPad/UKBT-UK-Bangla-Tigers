---
// ClubIntro — re-art-directed. Editorial composition:
// large image, large statement, supporting copy, typographic statistics.
// No cards, no overlay, no boxes around numbers.
interface Stat {
  value: string;
  label: string;
}
interface Props {
  tagline: string;
  stats: Stat[];
  founded: string;
}
const { tagline, stats, founded } = Astro.props;
---

<div class="ukbt-about">
  <div class="ukbt-about__image">
    <img
      src="/media/club-feature.webp"
      width="1400"
      height="933"
      alt="A UK Bangla Tigers player on the field"
      loading="lazy"
    />
  </div>
  <div class="ukbt-about__content">
    <h2 class="ukbt-about__headline">We're not just<br />a team.</h2>
    <p class="ukbt-about__lede">{tagline}</p>
    <p class="ukbt-about__founded">Founded in {founded}.</p>
    <div class="ukbt-about__stats">
      {
        stats.map((s) => (
          <div class="ukbt-about__stat">
            <span class="ukbt-about__stat-value">{s.value}</span>
            <span class="ukbt-about__stat-label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .ukbt-about {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-gap-100);
  }
  .ukbt-about__image {
    width: 100%;
  }
  .ukbt-about__image img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 36rem;
    object-fit: cover;
    border-radius: var(--ukbt-radius-ref-card);
  }
  .ukbt-about__content {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-4);
    max-width: 48rem;
  }
  .ukbt-about__headline {
    font-family: var(--ukbt-font-family-heading);
    font-size: clamp(2rem, 1.2rem + 3vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .ukbt-about__lede {
    font-size: var(--ukbt-font-size-2);
    color: var(--ukbt-color-neutral-700);
    max-width: 40rem;
    margin: 0;
  }
  .ukbt-about__founded {
    font-weight: var(--ukbt-font-weight-bold);
    color: var(--ukbt-color-neutral-700);
    margin: 0;
  }
  .ukbt-about__stats {
    display: flex;
    gap: var(--ukbt-space-gap-5);
    margin-top: var(--ukbt-space-4);
  }
  .ukbt-about__stat {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-1);
    border-top: 2px solid var(--ukbt-color-brand-accent);
    padding-top: var(--ukbt-space-2);
    min-width: 6rem;
  }
  .ukbt-about__stat-value {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-4);
    font-weight: var(--ukbt-font-weight-bold);
    color: var(--ukbt-color-brand-primary);
  }
  .ukbt-about__stat-label {
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-700);
  }

  @media screen and (max-width: 767px) {
    .ukbt-about__stats {
      flex-direction: column;
      gap: var(--ukbt-space-4);
    }
  }
</style>
