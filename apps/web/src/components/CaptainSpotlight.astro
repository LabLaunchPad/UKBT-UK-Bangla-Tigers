---
// CaptainSpotlight — re-art-directed. Editorial composition:
// large statement + clean info below. Not a two-column layout.
interface Props {
  name: string;
  role: string;
}
const { name, role } = Astro.props;
---

<div class="ukbt-captain">
  <span class="ukbt-captain__eyebrow">Club Captain</span>
  <h2 class="ukbt-captain__headline">Leading from the Front</h2>
  <div class="ukbt-captain__info">
    <span class="ukbt-captain__name">{name}</span>
    <span class="ukbt-captain__role">{role}</span>
  </div>
  <a href="/club-captain" class="ukbt-captain__link">Full profile &rarr;</a>
</div>

<style>
  .ukbt-captain {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-3);
    border-top: 3px solid var(--ukbt-color-brand-primary);
    padding-top: var(--ukbt-space-6);
  }
  .ukbt-captain__eyebrow {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-0);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ukbt-color-brand-accent);
  }
  .ukbt-captain__headline {
    font-family: var(--ukbt-font-family-heading);
    font-size: clamp(1.8rem, 1.2rem + 2vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .ukbt-captain__info {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-1);
  }
  .ukbt-captain__name {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-2);
    font-weight: 600;
  }
  .ukbt-captain__role {
    font-size: var(--ukbt-font-size-1);
    color: var(--ukbt-color-neutral-700);
  }
  .ukbt-captain__link {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--ukbt-color-brand-primary);
    font-weight: var(--ukbt-font-weight-bold);
    text-decoration: none;
    margin-top: var(--ukbt-space-2);
  }
  .ukbt-captain__link:hover {
    text-decoration: underline;
  }
</style>
