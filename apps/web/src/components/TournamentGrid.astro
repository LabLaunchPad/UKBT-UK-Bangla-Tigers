---
// TournamentGrid — re-art-directed. One large event + editorial CTA.
// Not four cards. Clean typography, accent border, no decorative tags.
interface Tournament {
  name: string;
  when: string;
  where: string;
}
interface Props {
  mainEvent: Tournament;
  otherEvents: Tournament[];
}
const { mainEvent, otherEvents } = Astro.props;
---

<div class="ukbt-tournaments">
  <div class="ukbt-tournaments__main">
    <span class="ukbt-tournaments__eyebrow">Next Tournament</span>
    <h2 class="ukbt-tournaments__title">{mainEvent.name}</h2>
    <div class="ukbt-tournaments__meta">
      <span>{mainEvent.when}</span>
      <span class="ukbt-tournaments__sep" aria-hidden="true">&middot;</span>
      <span>{mainEvent.where}</span>
    </div>
    <a href="/tournaments" class="ukbt-tournaments__link">See all tournaments &rarr;</a>
  </div>
  {
    otherEvents.length > 0 && (
      <div class="ukbt-tournaments__others">
        <span class="ukbt-tournaments__eyebrow">Also Coming</span>
        <ul class="ukbt-tournaments__list">
          {otherEvents.map((t) => (
            <li class="ukbt-tournaments__item">
              <span class="ukbt-tournaments__item-name">{t.name}</span>
              <span class="ukbt-tournaments__item-meta">
                {t.when} &middot; {t.where}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>

<style>
  .ukbt-tournaments {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-gap-100);
  }
  .ukbt-tournaments__main {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-3);
    border-top: 3px solid var(--ukbt-color-brand-accent);
    padding-top: var(--ukbt-space-6);
  }
  .ukbt-tournaments__eyebrow {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-0);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ukbt-color-brand-accent);
  }
  .ukbt-tournaments__title {
    font-family: var(--ukbt-font-family-heading);
    font-size: clamp(1.8rem, 1.2rem + 2vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .ukbt-tournaments__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ukbt-space-2);
    font-size: var(--ukbt-font-size-1);
    color: var(--ukbt-color-neutral-700);
  }
  .ukbt-tournaments__sep {
    color: var(--ukbt-color-brand-accent);
  }
  .ukbt-tournaments__link {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--ukbt-color-brand-primary);
    font-weight: var(--ukbt-font-weight-bold);
    text-decoration: none;
    margin-top: var(--ukbt-space-2);
  }
  .ukbt-tournaments__link:hover {
    text-decoration: underline;
  }

  .ukbt-tournaments__others {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-4);
  }
  .ukbt-tournaments__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-4);
  }
  .ukbt-tournaments__item {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-1);
    padding-top: var(--ukbt-space-4);
    border-top: 1px solid var(--ukbt-color-border-subtle);
  }
  .ukbt-tournaments__item-name {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-1);
    font-weight: 600;
  }
  .ukbt-tournaments__item-meta {
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-700);
  }

  @media (max-width: 767px) {
    .ukbt-tournaments__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--ukbt-space-1);
    }
    .ukbt-tournaments__sep {
      display: none;
    }
  }
</style>
