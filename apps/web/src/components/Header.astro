---
// Site header with dropdown navigation support.
// Parent items with children remain navigable — clicking the label navigates
// to the href, clicking the arrow/toggle opens the submenu.
// Dropdowns support mouse, keyboard (Enter, Space, ArrowDown, ArrowUp, Escape)
// and touch (accordion on mobile).
import type { NavItem } from '@ukbt/truth';
import Button from './Button.astro';

interface Props {
  nav: NavItem[];
  cta?: { label: string; href: string };
}
const { nav, cta } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<a href="#main-content" class="ukbt-skip-link">Skip to main content</a>

<header class="ukbt-header" id="ukbt-header">
  <div class="ukbt-container ukbt-header__bar">
    <a href="/" class="ukbt-header__brand" aria-label="UK Bangla Tigers — home">
      <img
        src="/brand/crest-120.png"
        width="60"
        height="82"
        alt=""
        class="ukbt-header__logo"
      />
    </a>

    <nav class="ukbt-header__nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li class:list={[item.children && 'ukbt-header__nav-item--has-dropdown']}>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
              {item.children && (
                <button
                  type="button"
                  class="ukbt-header__dropdown-toggle"
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-label={`${item.label} submenu`}
                >
                  <svg viewBox="0 0 12 12" width="10" height="10" fill="currentColor" aria-hidden="true">
                    <path d="M2 4l4 4 4-4" />
                  </svg>
                </button>
              )}
              {item.children && (
                <ul class="ukbt-header__dropdown" role="menu">
                  {item.children.map((child) => (
                    <li role="none">
                      <a href={child.href} role="menuitem" aria-current={isActive(child.href) ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ukbt-header__cta">
      {cta && <Button label={cta.label} href={cta.href} variant="primary" />}
    </div>

    <button
      type="button"
      id="ukbt-nav-toggle"
      class="ukbt-header__toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="ukbt-nav-drawer"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Off-canvas drawer (reference `.sidebar` + `.sidebar-overlay`) -->
  <div class="ukbt-header__overlay" id="ukbt-nav-overlay"></div>
  <div class="ukbt-header__drawer" id="ukbt-nav-drawer" role="dialog" aria-label="Site menu" aria-modal="true" inert>
    <div class="ukbt-header__drawer-head">
      <img src="/brand/crest-88.png" width="44" height="60" alt="" />
      <button type="button" class="ukbt-header__close" id="ukbt-nav-close" aria-label="Close menu">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <ul class="ukbt-header__drawer-menu">
      {
        nav.map((item) => (
          <li class:list={[item.children && 'ukbt-header__drawer-item--has-children']}>
            {item.children ? (
              <div class="ukbt-header__drawer-group">
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
                <button
                  type="button"
                  class="ukbt-header__drawer-accordion"
                  aria-expanded="false"
                  aria-label={`${item.label} submenu`}
                >
                  <svg viewBox="0 0 12 12" width="10" height="10" fill="currentColor" aria-hidden="true">
                    <path d="M2 4l4 4 4-4" />
                  </svg>
                </button>
              </div>
            ) : (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            )}
            {item.children && (
              <ul class="ukbt-header__drawer-submenu">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} aria-current={isActive(child.href) ? 'page' : undefined}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  // Real focusable toggle + inert-driven drawer — see the top-of-file
  // comment for why this replaced a checkbox+label CSS-only version.
  const header = document.getElementById('ukbt-header');
  const toggle = document.getElementById('ukbt-nav-toggle');
  const close = document.getElementById('ukbt-nav-close');
  const overlay = document.getElementById('ukbt-nav-overlay');
  const drawer = document.getElementById('ukbt-nav-drawer');

  function setOpen(open: boolean) {
    header?.classList.toggle('ukbt-header--open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    if (open) {
      drawer?.removeAttribute('inert');
    } else {
      drawer?.setAttribute('inert', '');
    }
    // Lock the page behind the drawer. Measured at 390x844: with the
    // drawer open, a scroll gesture moved the background from scrollY 0
    // to 700 while the menu stayed pinned — the page silently moved
    // under the overlay, so closing the menu returned the reader
    // somewhere they never navigated to.
    document.body.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  close?.addEventListener('click', () => {
    setOpen(false);
    toggle?.focus();
  });
  overlay?.addEventListener('click', () => {
    setOpen(false);
    toggle?.focus();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  // The drawer declares aria-modal="true", which tells assistive tech the
  // rest of the page is hidden — but it does NOT contain Tab. Measured at
  // 390x844: tabbing past the last drawer link moved focus to a <main>
  // social link (insideDrawer: false) sitting behind the dimmed overlay,
  // so a keyboard user silently operated controls a screen reader had
  // just declared non-existent. Contain focus to match the ARIA promise.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    if (toggle?.getAttribute('aria-expanded') !== 'true' || !drawer) return;
    const focusables = drawer.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])',
    );
    if (!focusables.length) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const active = document.activeElement;
    if (e.shiftKey && (active === first || !drawer.contains(active))) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    }
  });
  // Desktop dropdown toggles — click opens/closes submenu
  document.querySelectorAll<HTMLElement>('.ukbt-header__dropdown-toggle').forEach((btn) => {
    const menu = btn.closest('li')?.querySelector<HTMLElement>('.ukbt-header__dropdown');
    if (!menu) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      // Close all other dropdowns first
      document.querySelectorAll<HTMLElement>('.ukbt-header__dropdown-toggle').forEach((other) => {
        if (other !== btn) {
          other.setAttribute('aria-expanded', 'false');
          other.closest('li')?.querySelector<HTMLElement>('.ukbt-header__dropdown')
            ?.removeAttribute('aria-expanded');
        }
      });
      btn.setAttribute('aria-expanded', String(!expanded));
      menu.setAttribute('aria-expanded', String(!expanded));
    });
  });

  // Close desktop dropdowns when clicking outside
  document.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('.ukbt-header__dropdown-toggle').forEach((btn) => {
      btn.setAttribute('aria-expanded', 'false');
      btn.closest('li')?.querySelector<HTMLElement>('.ukbt-header__dropdown')
        ?.removeAttribute('aria-expanded');
    });
  });

  // Desktop dropdown keyboard navigation
  document.querySelectorAll<HTMLElement>('.ukbt-header__dropdown').forEach((menu) => {
    menu.addEventListener('keydown', (e) => {
      const items = menu.querySelectorAll<HTMLElement>('a[href]');
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;

      if (e.key === 'Escape') {
        const btn = menu.closest('li')?.querySelector<HTMLElement>('.ukbt-header__dropdown-toggle');
        btn?.setAttribute('aria-expanded', 'false');
        menu.removeAttribute('aria-expanded');
        btn?.focus();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (active === last) first?.focus();
        else {
          const idx = Array.from(items).indexOf(active as HTMLElement);
          items[idx + 1]?.focus();
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (active === first) last?.focus();
        else {
          const idx = Array.from(items).indexOf(active as HTMLElement);
          items[idx - 1]?.focus();
        }
      }
    });
  });

  // Drawer accordion toggles
  document.querySelectorAll<HTMLElement>('.ukbt-header__drawer-accordion').forEach((btn) => {
    const submenu = btn.closest('li')?.querySelector<HTMLElement>('.ukbt-header__drawer-submenu');
    if (!submenu) return;

    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      submenu.setAttribute('aria-expanded', String(!expanded));
    });
  });
</script>

<style>
  .ukbt-header {
    background: var(--ukbt-color-surface-inverse);
    color: var(--ukbt-color-surface-inverse-foreground);
    position: relative;
    z-index: 20;
  }
  /* Reference `.navbar-nav-container`: flex row, space-between, 20px pad. */
  .ukbt-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ukbt-space-gap-2);
    padding-block: var(--ukbt-space-gap-2);
    width: 100%;
  }
  /* Reference navbar padding steps with viewport (20px mobile / 40px
     tablet / 60px desktop — EV-20260826-032, reference-geometry.json
     navbar.padTop at 430/390, 1024/768, 1440/1280 respectively), giving
     measured heights of ~98-102px / 126-142px / 162px. The flat 20px
     used here previously matched only the mobile band, making the header
     37% shorter than the reference at desktop widths. Breakpoints reuse
     this component's own existing bands (768px = hero stack, 1280px =
     nav-collapse) rather than introducing new ones. */
  @media screen and (min-width: 768px) {
    .ukbt-header__bar {
      padding-block: var(--ukbt-space-gap-4);
    }
  }
  @media screen and (min-width: 1280px) {
    .ukbt-header__bar {
      padding-block: 60px;
    }
  }
  .ukbt-header__brand {
    display: flex;
    align-items: center;
    gap: var(--ukbt-space-gap-1);
    color: inherit;
    text-decoration: none;
    flex: none;
  }
  .ukbt-header__logo {
    height: 60px;
    width: auto;
    flex: none;
  }
  /* The reference's own brand slot is a bare logo image with no text
     wordmark. Reproducing that is also what makes the bar fit: with a
     wordmark the three regions measured 1501px against a 1340px
     container (brand 246 + nav 1044 + CTA 211). The accessible name is
     carried by the link's aria-label. */

  .ukbt-header__nav ul {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Reference `.nav-link`: Montserrat 16px/600, padding 0 15px. */
  .ukbt-header__nav a {
    display: block;
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-heading-h6-size);
    font-weight: var(--ukbt-font-weight-medium);
    line-height: 1;
    padding-inline: 15px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  .ukbt-header__nav a[aria-current='page'] {
    color: var(--ukbt-color-brand-accent);
    font-weight: var(--ukbt-font-weight-bold);
  }
  .ukbt-header__nav a:hover {
    color: var(--ukbt-color-brand-accent);
  }

  /* Dropdown toggle button — arrow next to nav items with children */
  .ukbt-header__nav-item--has-dropdown {
    position: relative;
  }
  .ukbt-header__dropdown-toggle {
    appearance: none;
    border: none;
    background: none;
    color: inherit;
    padding: 0;
    margin-inline-start: -4px;
    cursor: pointer;
    vertical-align: middle;
    line-height: 1;
  }
  .ukbt-header__dropdown-toggle svg {
    transition: transform 0.2s ease;
  }
  .ukbt-header__dropdown-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  /* Desktop dropdown menu */
  .ukbt-header__dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    margin: 0;
    padding: var(--ukbt-space-2) 0;
    list-style: none;
    background: var(--ukbt-color-surface-background);
    color: var(--ukbt-color-surface-foreground);
    border-radius: var(--ukbt-radius-ref-sm);
    box-shadow: var(--ukbt-shadow-md);
    z-index: 30;
  }
  .ukbt-header__dropdown[aria-expanded='true'],
  .ukbt-header__nav-item--has-dropdown:hover .ukbt-header__dropdown {
    display: block;
  }
  .ukbt-header__dropdown a {
    padding: var(--ukbt-space-2) var(--ukbt-space-4);
    border-bottom: none;
    font-size: var(--ukbt-font-size-1);
  }
  .ukbt-header__dropdown a[aria-current='page'] {
    background: var(--ukbt-color-surface-alt);
    border-radius: 0;
  }

  .ukbt-header__cta {
    flex: none;
  }

  .ukbt-header__toggle,
  .ukbt-header__overlay,
  .ukbt-header__drawer {
    display: none;
  }
  /* Reset <button> defaults now that the toggle/close controls are real
     buttons, not label+checkbox proxies. */
  .ukbt-header__toggle,
  .ukbt-header__close {
    appearance: none;
    border: none;
    font: inherit;
  }

  /* Seven nav items with UKBT's longer labels need more room than the
     reference's five (two of which are grouped dropdowns). Between 1280
     and 1439 the link padding tightens; below 1280 the bar can no longer
     seat nav + CTA inside the container, so the drawer takes over. */
  @media screen and (max-width: 1439px) {
    .ukbt-header__nav a {
      padding-inline: 8px;
    }
  }

  @media screen and (max-width: 1279px) {
    .ukbt-header__nav,
    .ukbt-header__cta {
      display: none;
    }
    .ukbt-header__toggle {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      cursor: pointer;
      /* padding-block raised 10px -> 14px (measured 50x36 -> 50x44): a
         mobile touch-target sweep found this button, the single most-used
         mobile interactive element on the site, under the 44x44 HIG/
         Material recommendation (WCAG 2.5.8's own floor is 24px, already
         met — this is a usability improvement, not an a11y-compliance
         fix). Width was already 50px, so only height needed to grow. */
      padding: 14px 14px;
      border-radius: var(--ukbt-radius-ref-xs);
      background: var(--ukbt-color-brand-accent);
    }
    .ukbt-header__toggle span {
      display: block;
      width: 22px;
      height: 2px;
      background: var(--ukbt-color-brand-accent-contrast);
    }

    /* Reference `.sidebar-overlay`: full-screen dim behind the drawer. */
    .ukbt-header__overlay {
      display: block;
      position: fixed;
      inset: 0;
      /* Stage 8 red team F8: was a bare rgb() literal. Now references the
         overlay.scrim token (packages/truth/src/tokens/approved/color.json),
         which carries the identical rgba(0,0,0,0.53) value. Named so any
         future overlay uses the same token, not another literal. */
      background: var(--ukbt-color-overlay-scrim);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s ease-in-out;
      z-index: 30;
    }
    /* Reference `.sidebar`: fixed, 300px, slides in from the left. */
    .ukbt-header__drawer {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      left: 0;
      width: 300px;
      max-width: 85vw;
      height: 100%;
      max-height: 100vh;
      overflow-y: auto;
      background: var(--ukbt-color-surface-background);
      color: var(--ukbt-color-surface-foreground);
      transform: translateX(-100%);
      transition: transform 0.4s ease-in-out;
      z-index: 40;
    }
    .ukbt-header--open .ukbt-header__overlay {
      opacity: 1;
      pointer-events: auto;
    }
    .ukbt-header--open .ukbt-header__drawer {
      transform: translateX(0);
    }
  }

  /* Reference `.sidebar-header`: logo + close, space-between, 20px pad. */
  .ukbt-header__drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--ukbt-space-gap-2);
    border-bottom: 1px solid var(--ukbt-color-neutral-100);
  }
  /* 36x36 -> 44x44 (mobile touch-target sweep): same 44x44 HIG/Material
     minimum as .ukbt-header__toggle above. */
  .ukbt-header__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--ukbt-radius-ref-circle);
    background: var(--ukbt-color-surface-alt);
    color: var(--ukbt-color-brand-primary);
    cursor: pointer;
  }
  .ukbt-header__drawer-menu {
    list-style: none;
    margin: 0;
    padding: var(--ukbt-space-gap-2);
    display: flex;
    flex-direction: column;
  }
  .ukbt-header__drawer-menu a {
    display: block;
    padding: var(--ukbt-space-gap-2) var(--ukbt-space-gap-1);
    color: var(--ukbt-color-brand-primary);
    text-decoration: none;
    font-family: var(--ukbt-font-family-heading);
    font-weight: var(--ukbt-font-weight-medium);
    border-bottom: 1px solid var(--ukbt-color-neutral-100);
  }
  .ukbt-header__drawer-menu a[aria-current='page'] {
    color: var(--ukbt-color-brand-accent-contrast);
    background: var(--ukbt-color-brand-accent);
    border-radius: var(--ukbt-radius-ref-xs);
  }

  /* Drawer accordion — items with children get expand/collapse toggle */
  .ukbt-header__drawer-group {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--ukbt-color-neutral-100);
  }
  .ukbt-header__drawer-group a {
    flex: 1;
    border-bottom: none;
  }
  .ukbt-header__drawer-accordion {
    appearance: none;
    border: none;
    background: none;
    color: inherit;
    padding: var(--ukbt-space-gap-2);
    cursor: pointer;
    line-height: 1;
  }
  .ukbt-header__drawer-accordion svg {
    transition: transform 0.2s ease;
  }
  .ukbt-header__drawer-accordion[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .ukbt-header__drawer-submenu {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--ukbt-space-gap-4);
  }
  .ukbt-header__drawer-submenu[aria-expanded='true'] {
    display: block;
  }
  .ukbt-header__drawer-submenu a {
    font-size: var(--ukbt-font-size-0);
    padding: var(--ukbt-space-gap-1) var(--ukbt-space-gap-2);
    border-bottom: none;
  }

  /* Accessibility skip link for keyboard navigation */
  .ukbt-skip-link {
    position: absolute;
    top: -9999px;
    left: var(--ukbt-space-gap-2);
    z-index: 100;
    padding: var(--ukbt-space-gap-1) var(--ukbt-space-gap-2);
    background: var(--ukbt-color-brand-accent);
    color: var(--ukbt-color-brand-accent-contrast);
    font-family: var(--ukbt-font-family-heading);
    font-weight: var(--ukbt-font-weight-bold);
    text-decoration: none;
    border-radius: var(--ukbt-radius-ref-xs);
  }
  .ukbt-skip-link:focus-visible {
    top: var(--ukbt-space-gap-2);
  }

  /* Never the reference's invisible-outline defect. */
  .ukbt-header a:focus-visible,
  .ukbt-header button:focus-visible {
    outline: 2px solid var(--ukbt-color-brand-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ukbt-header__drawer,
    .ukbt-header__overlay {
      transition: none;
    }
  }
</style>
