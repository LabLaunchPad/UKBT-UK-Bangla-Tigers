---
// Site header with dropdown navigation support.
// Parent items with children remain navigable — clicking the label navigates
// to the href, clicking the arrow/toggle opens the submenu.
// Dropdowns support mouse, keyboard (Enter, Space, ArrowDown, ArrowUp, Escape)
// and touch (accordion on mobile).
import type { NavItem } from '@ukbt/truth';
import Button from './Button.astro';

interface Props {
  nav: NavItem[];
  cta?: { label: string; href: string };
}
const { nav, cta } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<a href="#main-content" class="ukbt-skip-link">Skip to main content</a>

<header class="ukbt-header" id="ukbt-header">
  <div class="ukbt-container ukbt-header__bar">
    <a href="/" class="ukbt-header__brand" aria-label="UK Bangla Tigers — home">
      <img
        src="/brand/crest-256.webp"
        width="44"
        height="60"
        alt=""
        class="ukbt-header__logo"
      />
    </a>

    <nav class="ukbt-header__nav" aria-label="Primary">
      <ul>
        {
          nav.map((item, i) => (
            <li class:list={[item.children && 'ukbt-header__nav-item--has-dropdown']}>
              <a
                href={item.href}
                aria-label={item.ariaLabel}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
              {item.children && (
                <button
                  type="button"
                  class="ukbt-header__dropdown-toggle"
                  aria-expanded="false"
                  aria-haspopup="menu"
                  aria-controls={`ukbt-dropdown-menu-${i}`}
                  aria-label={`${item.ariaLabel ?? item.label} submenu`}
                >
                  <svg viewBox="0 0 12 12" width="10" height="10" fill="currentColor" aria-hidden="true">
                    <path d="M2 4l4 4 4-4" />
                  </svg>
                </button>
              )}
              {item.children && (
                <ul class="ukbt-header__dropdown" role="menu" id={`ukbt-dropdown-menu-${i}`}>
                  {item.children.map((child) => (
                    <li role="none">
                      <a href={child.href} role="menuitem" aria-current={isActive(child.href) ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ukbt-header__cta">
      {cta && <Button label={cta.label} href={cta.href} variant="primary" />}
    </div>

    <button
      type="button"
      id="ukbt-nav-toggle"
      class="ukbt-header__toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="ukbt-nav-drawer"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Off-canvas drawer (reference `.sidebar` + `.sidebar-overlay`) -->
  <div class="ukbt-header__overlay" id="ukbt-nav-overlay"></div>
  <div class="ukbt-header__drawer" id="ukbt-nav-drawer" role="dialog" aria-label="Site menu" aria-modal="true" inert>
    <div class="ukbt-header__drawer-head">
      <img src="/brand/crest-256.webp" width="44" height="60" alt="" />
      <button type="button" class="ukbt-header__close" id="ukbt-nav-close" aria-label="Close menu">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <ul class="ukbt-header__drawer-menu">
      {
        nav.map((item, i) => (
          <li
            class:list={[item.children && 'ukbt-header__drawer-item--has-children']}
            style={`--ukbt-motion-index: ${i}`}
          >
            {item.children ? (
              <div class="ukbt-header__drawer-group">
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
                <button
                  type="button"
                  class="ukbt-header__drawer-accordion"
                  aria-expanded="false"
                  aria-label={`${item.label} submenu`}
                >
                  <svg viewBox="0 0 12 12" width="10" height="10" fill="currentColor" aria-hidden="true">
                    <path d="M2 4l4 4 4-4" />
                  </svg>
                </button>
              </div>
            ) : (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            )}
            {item.children && (
              <ul class="ukbt-header__drawer-submenu">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} aria-current={isActive(child.href) ? 'page' : undefined}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  // Real focusable toggle + inert-driven drawer — see the top-of-file
  // comment for why this replaced a checkbox+label CSS-only version.
  const header = document.getElementById('ukbt-header');
  const toggle = document.getElementById('ukbt-nav-toggle');
  const close = document.getElementById('ukbt-nav-close');
  const overlay = document.getElementById('ukbt-nav-overlay');
  const drawer = document.getElementById('ukbt-nav-drawer');

  function setOpen(open: boolean) {
    header?.classList.toggle('ukbt-header--open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    if (open) {
      drawer?.removeAttribute('inert');
    } else {
      drawer?.setAttribute('inert', '');
    }
    // Lock the page behind the drawer. Measured at 390x844: with the
    // drawer open, a scroll gesture moved the background from scrollY 0
    // to 700 while the menu stayed pinned — the page silently moved
    // under the overlay, so closing the menu returned the reader
    // somewhere they never navigated to.
    document.body.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  close?.addEventListener('click', () => {
    setOpen(false);
    toggle?.focus();
  });
  overlay?.addEventListener('click', () => {
    setOpen(false);
    toggle?.focus();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  // The drawer declares aria-modal="true", which tells assistive tech the
  // rest of the page is hidden — but it does NOT contain Tab. Measured at
  // 390x844: tabbing past the last drawer link moved focus to a <main>
  // social link (insideDrawer: false) sitting behind the dimmed overlay,
  // so a keyboard user silently operated controls a screen reader had
  // just declared non-existent. Contain focus to match the ARIA promise.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    if (toggle?.getAttribute('aria-expanded') !== 'true' || !drawer) return;
    const focusables = drawer.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])',
    );
    if (!focusables.length) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const active = document.activeElement;
    if (e.shiftKey && (active === first || !drawer.contains(active))) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    }
  });
  // Desktop dropdowns — single-open state machine. Visibility is driven
  // ONLY by aria-expanded (no CSS :hover display rule), so two menus can
  // never show at once. Hover is an enhancement on hover-capable devices;
  // touch uses tap-to-toggle exclusively (a tap fires mouseenter before
  // click, which would otherwise open-then-immediately-close).
  const supportsHover = window.matchMedia('(hover: hover)').matches;
  const dropdownItems = Array.from(
    document.querySelectorAll<HTMLElement>('.ukbt-header__nav-item--has-dropdown'),
  );

  function setDropdown(
    item: HTMLElement,
    open: boolean,
    opts: { refocus?: boolean } = {},
  ) {
    const btn = item.querySelector<HTMLElement>('.ukbt-header__dropdown-toggle');
    const menu = item.querySelector<HTMLElement>('.ukbt-header__dropdown');
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', String(open));
    if (open) menu.setAttribute('aria-expanded', 'true');
    else menu.removeAttribute('aria-expanded');
    if (!open && opts.refocus) btn.focus();
  }

  function closeAllDropdowns(except?: HTMLElement) {
    dropdownItems.forEach((item) => {
      if (item !== except) {
        setDropdown(item, false);
        item.removeAttribute('data-opened-by');
      }
    });
  }

  function isDropdownOpen(item: HTMLElement) {
    return (
      item.querySelector('.ukbt-header__dropdown-toggle')?.getAttribute('aria-expanded') ===
      'true'
    );
  }

  dropdownItems.forEach((item) => {
    const btn = item.querySelector<HTMLElement>('.ukbt-header__dropdown-toggle');
    const menu = item.querySelector<HTMLElement>('.ukbt-header__dropdown');
    if (!btn || !menu) return;

    // Click / tap toggles. A real mouse click (e.detail > 0) that follows
    // a hover-open is a no-op keep-open: without this, moving the mouse
    // onto the chevron (mouseenter opens) then clicking would instantly
    // close the menu the user just opened. Keyboard-synthesised clicks
    // (e.detail === 0) and touch taps always toggle.
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (
        e.detail > 0 &&
        isDropdownOpen(item) &&
        item.getAttribute('data-opened-by') === 'hover'
      ) {
        return;
      }
      const willOpen = !isDropdownOpen(item);
      closeAllDropdowns(item);
      setDropdown(item, willOpen);
      item.setAttribute('data-opened-by', 'toggle');
    });

    // Pointer hover opens (and closes any other) on hover-capable devices.
    if (supportsHover) {
      item.addEventListener('mouseenter', () => {
        closeAllDropdowns(item);
        if (!isDropdownOpen(item)) {
          setDropdown(item, true);
          item.setAttribute('data-opened-by', 'hover');
        }
      });
      item.addEventListener('mouseleave', () => {
        setDropdown(item, false);
        item.removeAttribute('data-opened-by');
      });
    }

    // ArrowDown/ArrowUp on the trigger opens and moves focus into the menu.
    // Escape on the trigger closes.
    btn.addEventListener('keydown', (e) => {
      const links = menu.querySelectorAll<HTMLElement>('a[href]');
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        closeAllDropdowns(item);
        setDropdown(item, true);
        item.setAttribute('data-opened-by', 'toggle');
        (e.key === 'ArrowDown' ? links[0] : links[links.length - 1])?.focus();
      } else if (e.key === 'Escape' && isDropdownOpen(item)) {
        e.preventDefault();
        setDropdown(item, false);
      }
    });

    // Tabbing out of the item closes it; focus never lingers invisibly
    // inside a closed menu.
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node)) setDropdown(item, false);
    });
  });

  // Close desktop dropdowns when clicking outside.
  document.addEventListener('click', () => {
    closeAllDropdowns();
  });

  // Desktop dropdown keyboard navigation inside an open menu.
  document.querySelectorAll<HTMLElement>('.ukbt-header__dropdown').forEach((menu) => {
    menu.addEventListener('keydown', (e) => {
      const items = menu.querySelectorAll<HTMLElement>('a[href]');
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;
      const item = menu.closest<HTMLElement>('.ukbt-header__nav-item--has-dropdown');

      if (e.key === 'Escape') {
        if (item) setDropdown(item, false, { refocus: true });
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (active === last) first?.focus();
        else {
          const idx = Array.from(items).indexOf(active as HTMLElement);
          items[idx + 1]?.focus();
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (active === first) last?.focus();
        else {
          const idx = Array.from(items).indexOf(active as HTMLElement);
          items[idx - 1]?.focus();
        }
      }
    });
  });

  // Drawer accordion toggles
  document.querySelectorAll<HTMLElement>('.ukbt-header__drawer-accordion').forEach((btn) => {
    const submenu = btn.closest('li')?.querySelector<HTMLElement>('.ukbt-header__drawer-submenu');
    if (!submenu) return;

    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      submenu.setAttribute('aria-expanded', String(!expanded));
    });
  });
</script>

<style>
  .ukbt-header {
    background: var(--ukbt-color-surface-inverse);
    color: var(--ukbt-color-surface-inverse-foreground);
    position: relative;
    z-index: var(--ukbt-z-header);
  }
  /* Three explicit layout regions — brand | navigation | CTA — so the
     nav never competes with the CTA for the same flex space. The middle
     region is shrinkable (minmax 0) while brand and CTA keep intrinsic
     widths; the CTA is never squeezed. */
  .ukbt-header__bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--ukbt-space-gap-2);
    padding-block: var(--ukbt-space-gap-2);
    width: 100%;
  }
  /* Reference navbar padding steps with viewport (20px mobile / 40px
     tablet / 60px desktop — EV-20260826-032, reference-geometry.json
     navbar.padTop at 430/390, 1024/768, 1440/1280 respectively), giving
     measured heights of ~98-102px / 126-142px / 162px. The flat 20px
     used here previously matched only the mobile band, making the header
     37% shorter than the reference at desktop widths. Breakpoints reuse
     this component's own existing bands (768px = hero stack, 1280px =
     nav-collapse) rather than introducing new ones. */
  @media screen and (min-width: 768px) {
    .ukbt-header__bar {
      padding-block: var(--ukbt-space-gap-4);
    }
  }
  .ukbt-header__brand {
    display: flex;
    align-items: center;
    gap: var(--ukbt-space-gap-1);
    color: inherit;
    text-decoration: none;
    flex: none;
    grid-column: 1;
    justify-self: start;
  }
  /* One-time logo intro (first true document visit only — see
     BaseLayout's head script + swap lifecycle listeners). The brand
     settles from slightly above into its permanent place: transform +
     opacity only, end state identical to the static header. `backwards`
     holds the from-state for the first frame so the final logo never
     flashes before the animation starts. */
  html.ukbt-logo-intro .ukbt-header__brand {
    animation: ukbt-logo-intro var(--ukbt-motion-duration-intro)
      var(--ukbt-motion-easing-emphasized) backwards;
  }
  @keyframes ukbt-logo-intro {
    0% {
      opacity: 0.9;
      transform: translateY(-12px) scale(1.03);
    }
    70% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    85% {
      opacity: 1;
      transform: translateY(1px) scale(1);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
  @media screen and (max-width: 430px) {
    @keyframes ukbt-logo-intro {
      0% {
        opacity: 0.9;
        transform: translateY(-8px) scale(1.02);
      }
      70% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      85% {
        opacity: 1;
        transform: translateY(1px) scale(1);
      }
      100% {
        opacity: 1;
        transform: none;
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html.ukbt-logo-intro .ukbt-header__brand {
      animation: none;
    }
  }
  /* Full-artwork crest file (256x349): the square derivatives crop the
     shield's crown and base point. Displayed at 60px tall the width
     follows the true ratio (44px), matching the width/height attributes
     so there is no layout shift. */
  .ukbt-header__logo {
    height: 60px;
    width: auto;
    flex: none;
  }
  /* Compact brand at the smallest widths: the 60px crest plus bar
     padding consumes a disproportionate share of a 320px viewport. */
  @media screen and (max-width: 430px) {
    .ukbt-header__logo {
      height: 48px;
    }
  }
  /* The reference's own brand slot is a bare logo image with no text
     wordmark. Reproducing that is also what makes the bar fit: with a
     wordmark the three regions measured 1501px against a 1340px
     container (brand 246 + nav 1044 + CTA 211). The accessible name is
     carried by the link's aria-label. */

  .ukbt-header__nav {
    grid-column: 2;
    justify-self: center;
    min-width: 0;
  }
  /* Child combinator is load-bearing: a descendant selector here would
     also match the dropdown menus and force them into a horizontal flex
     row — items side-by-side, spilling past the menu box, both menus
     reading as one merged surface. The top-level row ONLY. */
  .ukbt-header__nav > ul {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Reference `.nav-link`: Montserrat 16px/600, padding 0 15px. */
  .ukbt-header__nav a {
    display: block;
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-heading-h6-size);
    font-weight: var(--ukbt-font-weight-medium);
    line-height: 1;
    padding-inline: 15px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  .ukbt-header__nav a[aria-current='page'] {
    color: var(--ukbt-color-brand-accent);
    font-weight: var(--ukbt-font-weight-bold);
  }
  .ukbt-header__nav a:hover {
    color: var(--ukbt-color-brand-accent);
  }
  /* Gold underline-reveal motif: the brand accent grows left-to-right
     under top-level labels on hover — interactive, not decorative. */
  .ukbt-header__nav > ul > li > a,
  .ukbt-header__nav > ul > li > div > a {
    position: relative;
  }
  .ukbt-header__nav > ul > li > a::after,
  .ukbt-header__nav > ul > li > div > a::after {
    content: '';
    position: absolute;
    left: 15px;
    right: 15px;
    bottom: -4px;
    height: 2px;
    background: var(--ukbt-color-brand-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--ukbt-motion-duration-base)
      var(--ukbt-motion-easing-standard);
  }
  .ukbt-header__nav > ul > li > a:hover::after,
  .ukbt-header__nav > ul > li > div > a:hover::after,
  .ukbt-header__nav > ul > li > a[aria-current='page']::after,
  .ukbt-header__nav > ul > li > div > a[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* Each dropdown owns its positioning context: the item is a flex row
     (label + chevron side by side, never stacked) and the menu anchors
     to it — never to the nav row, never to the viewport. */
  .ukbt-header__nav-item--has-dropdown {
    position: relative;
    display: flex;
    align-items: center;
  }
  .ukbt-header__dropdown-toggle {
    appearance: none;
    border: none;
    background: none;
    color: inherit;
    padding: var(--ukbt-space-1);
    margin-inline-start: -4px;
    cursor: pointer;
    vertical-align: middle;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 24px;
  }
  .ukbt-header__dropdown-toggle svg {
    transition: transform var(--ukbt-motion-duration-base)
      var(--ukbt-motion-easing-standard);
  }
  .ukbt-header__dropdown-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  /* Desktop dropdown menu. Width is content-aware (max-content within
     viewport-safe bounds) so the single-child Franchises menu stays
     compact while the three-child Events menu takes only the room it
     needs — a menu never stretches into a neighbour's trigger zone, so
     two menus can never read as one merged surface.
     Visibility is driven ONLY by JS-managed aria-expanded (single-open
     invariant). There is deliberately no :hover display rule. */
  .ukbt-header__nav .ukbt-header__dropdown {
    display: none;
    position: absolute;
    top: calc(100% + var(--ukbt-space-2));
    left: 0;
    width: max-content;
    min-width: 0;
    max-width: min(20rem, calc(100vw - var(--ukbt-space-gap-4)));
    margin: 0;
    padding: var(--ukbt-space-2) 0;
    list-style: none;
    background: var(--ukbt-color-surface-background);
    color: var(--ukbt-color-surface-foreground);
    border: 1px solid var(--ukbt-color-border-subtle);
    border-radius: var(--ukbt-radius-ref-sm);
    box-shadow: var(--ukbt-shadow-md);
    z-index: var(--ukbt-z-dropdown);
    transition:
      opacity var(--ukbt-motion-duration-fast) var(--ukbt-motion-easing-enter),
      translate var(--ukbt-motion-duration-fast) var(--ukbt-motion-easing-enter);
  }
  /* Entry-only dropdown motion: @starting-style animates the open frame
     where supported; elsewhere the menu appears instantly (documented
     progressive enhancement — exit is instant everywhere). */
  @starting-style {
    .ukbt-header__nav .ukbt-header__dropdown[aria-expanded='true'] {
      opacity: 0;
      translate: 0 -4px;
    }
  }
  /* Invisible hover bridge across the 8px offset: pointer travel from
     trigger to menu never leaves the item's subtree, so the menu cannot
     flicker closed mid-travel. */
  .ukbt-header__nav .ukbt-header__dropdown::before {
    content: '';
    position: absolute;
    top: calc(-1 * var(--ukbt-space-2));
    left: 0;
    right: 0;
    height: var(--ukbt-space-2);
  }
  .ukbt-header__nav .ukbt-header__dropdown[aria-expanded='true'] {
    display: block;
  }
  .ukbt-header__nav .ukbt-header__dropdown a {
    padding: var(--ukbt-space-3) var(--ukbt-space-4);
    border-bottom: none;
    font-size: var(--ukbt-font-size-1);
    white-space: nowrap;
  }
  .ukbt-header__nav .ukbt-header__dropdown a[aria-current='page'] {
    background: var(--ukbt-color-surface-alt);
    border-radius: 0;
  }

  .ukbt-header__cta {
    grid-column: 3;
    justify-self: end;
    flex: none;
  }

  .ukbt-header__toggle,
  .ukbt-header__overlay,
  .ukbt-header__drawer {
    display: none;
  }
  /* Reset <button> defaults now that the toggle/close controls are real
     buttons, not label+checkbox proxies. */
  .ukbt-header__toggle,
  .ukbt-header__close {
    appearance: none;
    border: none;
    font: inherit;
  }

  /* Seven nav items with UKBT's longer labels need more room than the
     reference's five (two of which are grouped dropdowns). Between 1280
     and 1439 the link padding tightens; below 1280 the bar can no longer
     seat nav + CTA inside the container, so the drawer takes over. */
  @media screen and (max-width: 1439px) {
    .ukbt-header__nav a {
      padding-inline: 8px;
    }
  }

  @media screen and (max-width: 1279px) {
    /* Sticky on mobile/tablet: nav + CTA are hidden behind the drawer
       here, so the brand and menu button stay reachable without
       scrolling back. Desktop keeps the in-flow header. */
    .ukbt-header {
      position: sticky;
      top: 0;
    }
    .ukbt-header__nav,
    .ukbt-header__cta {
      display: none;
    }
    .ukbt-header__toggle {
      display: flex;
      grid-column: 3;
      justify-self: end;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      cursor: pointer;
      /* 50x48: the 44px height met WCAG 2.5.8 but not the 48px
         touch-target floor — padding-block 14px -> 16px closes the gap
         with no visual change to the bars themselves. */
