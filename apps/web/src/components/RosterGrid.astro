---
// UKBT-original. Photo is optional and only rendered when supplied
// (EV-20260831-008 is the first real roster photography this project
// has — before it, no player photo existed for anyone, so every card
// was text-only, same discipline as LeadershipGrid.astro). A card with
// no photo stays text-only rather than showing a placeholder silhouette
// standing in for a real person.
//
// `country` is optional: EV-20260831-006 records one real case (Roushan
// Singh) where three supplied documents gave three different countries
// for the same person — rather than guess one, the field is left unset
// and the card says so explicitly ("Country unconfirmed"), never a
// silently blank line. (Resolved to Portugal in EV-20260831-008 once
// photographic evidence tipped the balance — the mechanism stays for
// the next time this happens.)
// Deliberately eager, not `loading="lazy"`: measured with a real
// full-page screenshot capture (screenshots.spec.ts) — below-the-fold
// roster photos silently failed to render because the browser's lazy
// IntersectionObserver never fired before the capture reached that
// scroll region. At most 42 small (<=100KB) images on the heaviest
// page, so the reliability cost of eager loading is worth paying here.
interface Player {
  name: string;
  country?: string;
  tags?: string[];
  note?: string;
  photo?: string;
  photoAlt?: string;
}
interface Props {
  players: Player[];
}
const { players } = Astro.props;
---

<div class="ukbt-roster-grid">
  {
    players.map((p: Player) => (
      <div class="ukbt-roster-card">
        {p.photo && (
          <img
            class="ukbt-roster-card__photo"
            src={p.photo}
            alt={p.photoAlt ?? `${p.name} — Uppsala Tigers`}
            width="160"
            height="160"
          />
        )}
        <div class="ukbt-roster-card__body">
          <h3>{p.name}</h3>
          <p class="ukbt-roster-card__country">
            {p.country ?? 'Country unconfirmed'}
          </p>
          {p.tags && p.tags.length > 0 && (
            <ul class="ukbt-roster-card__tags">
              {p.tags.map((t: string) => (
                <li>{t}</li>
              ))}
            </ul>
          )}
          {p.note && <p class="ukbt-roster-card__note">{p.note}</p>}
        </div>
      </div>
    ))
  }
</div>

<style>
  .ukbt-roster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--ukbt-space-4);
  }
  .ukbt-roster-card {
    background: var(--ukbt-color-surface-alt);
    border-radius: var(--ukbt-radius-lg);
    overflow: hidden;
    border-top: 3px solid var(--ukbt-color-brand-accent);
  }
  .ukbt-roster-card__photo {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    /* Faces sit high in most of the supplied portraits (headshot
       framing, not full-body) — top-anchoring crops feet/torso before
       it crops a face. */
    object-position: top center;
    background: var(--ukbt-color-surface);
  }
  .ukbt-roster-card__body {
    padding: var(--ukbt-space-4);
  }
  /* Promoted from h4 to h3 (found by a mobile axe-core sweep across all
     16 routes: this component's only call site, then /franchises, now
     /franchises/uppsala-tigers (contracts/ROUTE-CONTRACT.md AMENDMENT
     02), puts it directly after an h2 with no h3 between — the same
     class of gap F4 fixed on the homepage, but never checked
     page-by-page). Explicit size keeps the pre-existing visual weight. */
  .ukbt-roster-card h3 {
    margin: 0 0 var(--ukbt-space-1) 0;
    font-size: var(--ukbt-font-size-1);
  }
  .ukbt-roster-card__country {
    margin: 0;
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-size-0);
  }
  .ukbt-roster-card__tags {
    list-style: none;
    margin: var(--ukbt-space-2) 0 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ukbt-space-1);
  }
  .ukbt-roster-card__tags li {
    background: var(--ukbt-color-surface);
    border-radius: var(--ukbt-radius-sm, 4px);
    padding: 2px var(--ukbt-space-1);
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-700);
  }
  .ukbt-roster-card__note {
    margin: var(--ukbt-space-2) 0 0 0;
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-700);
    font-style: italic;
  }
</style>
