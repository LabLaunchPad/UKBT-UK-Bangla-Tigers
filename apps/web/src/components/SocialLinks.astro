---
// SocialLinks — single source of truth for social-link presentation.
// Replaces three divergent treatments (Hero text row, AboutCTA text row,
// Footer icon list) with one primitive: icon + correct brand display name,
// tone-aware colour, responsive label collapsing.
//
// Brand display names live here, not in data: the content layer stores
// machine identifiers ('tiktok'); human naming ('TikTok') is presentational.
export const SOCIAL_DISPLAY_NAMES: Record<string, string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  tiktok: 'TikTok',
  x: 'X',
};

export const SOCIAL_ICONS: Record<string, string> = {
  facebook:
    'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12',
  instagram:
    'M12 2c2.7 0 3.1 0 4.1.1 1.1 0 1.8.2 2.5.5.7.3 1.2.6 1.7 1.1.5.5.9 1 1.1 1.7.3.7.5 1.4.5 2.5.1 1 .1 1.4.1 4.1s0 3.1-.1 4.1c0 1.1-.2 1.8-.5 2.5-.3.7-.6 1.2-1.1 1.7-.5.5-1 .9-1.7 1.1-.7.3-1.4.5-2.5.5-1 .1-1.4.1-4.1.1s-3.1 0-4.1-.1c-1.1 0-1.8-.2-2.5-.5-.7-.3-1.2-.6-1.7-1.1-.5-.5-.9-1-1.1-1.7-.3-.7-.5-1.4-.5-2.5C2 15.1 2 14.7 2 12s0-3.1.1-4.1c0-1.1.2-1.8.5-2.5.3-.7.6-1.2 1.1-1.7.5-.5 1-.9 1.7-1.1.7-.3 1.4-.5 2.5-.5C8.9 2 9.3 2 12 2Zm0 2c-2.6 0-3 0-4 .1-.9 0-1.4.2-1.7.3-.4.2-.7.4-1 .7-.3.3-.5.6-.7 1-.1.3-.3.8-.3 1.7C4.2 9 4.2 9.4 4.2 12s0 3 .1 4c0 .9.2 1.4.3 1.7.2.4.4.7.7 1 .3.3.6.5 1 .7.3.1.8.3 1.7.3 1 .1 1.4.1 4 .1s3 0 4-.1c.9 0 1.4-.2 1.7-.3.4-.2.7-.4 1-.7.3-.3.5-.6.7-1 .1-.3.3-.8.3-1.7.1-1 .1-1.4.1-4s0-3-.1-4c0-.9-.2-1.4-.3-1.7-.2-.4-.4-.7-.7-1-.3-.3-.6-.5-1-.7-.3-.1-.8-.3-1.7-.3-1-.1-1.4-.1-4-.1Zm0 3.5A4.5 4.5 0 1 1 12 16a4.5 4.5 0 0 1 0-9Zm0 2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Zm4.8-2.7a1 1 0 1 1 0 2.1 1 1 0 0 1 0-2.1Z',
  tiktok:
    'M14 2h3a5 5 0 0 0 5 5v3a8 8 0 0 1-5-1.7V15a6 6 0 1 1-6-6c.3 0 .7 0 1 .1v3.1a3 3 0 1 0 2 2.8V2Z',
  x: 'M3 3l7.4 9.5L3.2 21H6l5.7-6.4L16 21h5l-7.7-9.9L20.6 3h-2.8l-5.3 5.9L8 3H3Z',
};

export function socialDisplayName(platform: string): string {
  return SOCIAL_DISPLAY_NAMES[platform] ?? platform.charAt(0).toUpperCase() + platform.slice(1);
}

interface SocialLink {
  platform: string;
  url: string;
}

interface Props {
  links: SocialLink[];
  /** Accessible name for the list. */
  label?: string;
  /** Colour treatment for the surface this renders on. */
  tone?: 'on-dark' | 'on-light';
  /** Layout direction. */
  direction?: 'row' | 'column';
  /** Collapse to icons-only at small mobile widths. */
  iconsOnlyOnMobile?: boolean;
}

const {
  links,
  label = 'UK Bangla Tigers on social media',
  tone = 'on-dark',
  direction = 'row',
  iconsOnlyOnMobile = false,
} = Astro.props;

const cls = [
  'ukbt-social-links',
  `ukbt-social-links--${tone}`,
  `ukbt-social-links--${direction}`,
  iconsOnlyOnMobile ? 'ukbt-social-links--icons-mobile' : '',
]
  .filter(Boolean)
  .join(' ');
---

<ul class={cls} aria-label={label}>
  {
    links.map((s) => (
      <li>
        <a
          href={s.url}
          aria-label={`UK Bangla Tigers on ${socialDisplayName(s.platform)}`}
          rel="me noopener"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor">
            <path d={SOCIAL_ICONS[s.platform]} />
          </svg>
          <span>{socialDisplayName(s.platform)}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .ukbt-social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ukbt-space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ukbt-social-links--column {
    flex-direction: column;
    gap: var(--ukbt-space-1);
  }
  .ukbt-social-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--ukbt-space-2);
    min-height: 24px;
    text-decoration: none;
    font-size: var(--ukbt-font-size-0);
    color: inherit;
  }
  /* Muted label on dark surfaces uses neutral-100, not neutral-300:
     neutral-300 on navy measures ~4.3:1, below the WCAG AA 4.5:1 floor
     for normal text (same systemic fix as AcademySection counters). */
  .ukbt-social-links--on-dark a {
    color: var(--ukbt-color-neutral-100);
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }
  .ukbt-social-links--on-dark a:hover {
    opacity: 1;
    color: var(--ukbt-color-brand-accent);
  }
  .ukbt-social-links--on-light a {
    color: var(--ukbt-color-brand-primary);
    font-weight: var(--ukbt-font-weight-bold);
  }
  .ukbt-social-links--on-light a:hover {
    text-decoration: underline;
  }
  /* Visually-hidden (not display:none): icons alone still expose the
     accessible name to assistive tech. */
  @media screen and (max-width: 430px) {
    .ukbt-social-links--icons-mobile span {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>
