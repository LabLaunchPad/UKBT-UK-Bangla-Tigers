---
// Hero — photographic team backdrop (client-authorised gallery asset
// team-huddle.webp; see src/assets/MANIFEST.md for the provenance
// caveat) under a navy scrim, with the editorial type composition on
// top. No crest here: brand identity already anchors the header, and a
// repeated mark would compete with the headline.
import Button from './Button.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
  taglineShort: string;
  social: { platform: string; url: string }[];
}
const { taglineShort, social } = Astro.props;
---

<div class="ukbt-hero">
  <img
    src="/media/team-huddle.webp"
    width="1080"
    height="720"
    alt=""
    fetchpriority="high"
    class="ukbt-hero__bg"
  />
  <div class="ukbt-hero__scrim" aria-hidden="true"></div>
  <div class="ukbt-container ukbt-hero__inner">
    <div class="ukbt-hero__content">
      <h1 class="ukbt-hero__headline">
        We're not just<br />a team.
      </h1>
      <p class="ukbt-hero__tagline">{taglineShort}</p>
      <div class="ukbt-hero__actions">
        <Button label="Join the Club" href="/join" variant="primary" />
      </div>
      <div class="ukbt-hero__social">
        <SocialLinks links={social} tone="on-dark" iconsOnlyOnMobile={true} />
      </div>
    </div>
  </div>
</div>

<style>
  .ukbt-hero {
    position: relative;
    overflow: hidden;
    background: var(--ukbt-color-surface-inverse);
    color: var(--ukbt-color-surface-inverse-foreground);
    --ukbt-color-focus-ring: var(--ukbt-color-brand-accent);
  }
  /* Team photograph, cover-cropped with the huddle mass kept in frame.
     An <img> (not a CSS background) so the LCP element keeps
     fetchpriority and intrinsic dimensions. Decorative: empty alt. */
  .ukbt-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% 35%;
  }
  /* Legibility scrim, darkest where the type sits (left). Mixed from the
     surface-inverse token — no literal colour values (color-mix has
     precedent in Footer.astro). */
  .ukbt-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--ukbt-color-surface-inverse) 93%, transparent) 0%,
      color-mix(in srgb, var(--ukbt-color-surface-inverse) 82%, transparent) 45%,
      color-mix(in srgb, var(--ukbt-color-surface-inverse) 60%, transparent) 100%
    );
  }
  .ukbt-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    /* First-viewport fill: header heights are deterministic from this
       system's own bar geometry (logo + padding-block) — 88px at <=430px
       (48px logo + 2x20px pad), 100px below 768px (60px logo + 2x20px
       pad), 140px at >=768px (60px logo + 2x40px pad). vh first as the
       fallback, svh for browsers with dynamic chrome. min-height, never
       height, so short viewports still grow to fit the content. */
    min-height: calc(100vh - 100px);
    min-height: calc(100svh - 100px);
    padding-block: var(--ukbt-space-section-padding);
  }
  @media screen and (max-width: 430px) {
    .ukbt-hero__inner {
      min-height: calc(100vh - 88px);
      min-height: calc(100svh - 88px);
    }
  }
  @media screen and (min-width: 768px) {
    .ukbt-hero__inner {
      min-height: calc(100vh - 140px);
      min-height: calc(100svh - 140px);
    }
  }
  /* At >=1280px the header CTA pill (~62px) is 2px taller than the 60px
     logo, stretching the bar from 140px to 142px (measured). */
  @media screen and (min-width: 1280px) {
    .ukbt-hero__inner {
      min-height: calc(100vh - 142px);
      min-height: calc(100svh - 142px);
    }
  }
  .ukbt-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ukbt-space-4);
    max-width: 48rem;
  }
  .ukbt-hero__headline {
    font-family: var(--ukbt-font-family-heading);
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    font-weight: 700;
    line-height: 1.05;
    margin: 0;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .ukbt-hero__tagline {
    font-family: var(--ukbt-font-family-heading);
    color: var(--ukbt-color-brand-accent);
    font-size: var(--ukbt-font-size-2);
    font-weight: 600;
    margin: 0;
  }
  .ukbt-hero__actions {
    margin-top: var(--ukbt-space-2);
  }
  .ukbt-hero :global(.ukbt-button--primary) {
    background: var(--ukbt-color-brand-accent);
    border-color: var(--ukbt-color-brand-accent);
    color: var(--ukbt-color-brand-accent-contrast);
  }
  .ukbt-hero :global(.ukbt-button--primary:hover) {
    background: var(--ukbt-color-brand-accent-hover);
    border-color: var(--ukbt-color-brand-accent-hover);
  }
  .ukbt-hero__social {
    margin: var(--ukbt-space-4) 0 0 0;
  }

  @media screen and (max-width: 767px) {
    .ukbt-hero__headline {
      font-size: clamp(2rem, 1.2rem + 4vw, 3rem);
    }
    /* Match the Section component's mobile step-down (120px -> 80px) so
       padding doesn't consume the small-viewport hero. */
    .ukbt-hero__inner {
      padding-block: 80px;
    }
    /* Portrait crop: bias toward the players (right of frame) and deepen
       the scrim so type stays legible over a narrower photo slice. */
    .ukbt-hero__bg {
      object-position: 72% 30%;
    }
    .ukbt-hero__scrim {
      background: linear-gradient(
        100deg,
        color-mix(in srgb, var(--ukbt-color-surface-inverse) 95%, transparent) 0%,
        color-mix(in srgb, var(--ukbt-color-surface-inverse) 88%, transparent) 60%,
        color-mix(in srgb, var(--ukbt-color-surface-inverse) 72%, transparent) 100%
      );
    }
  }
</style>
