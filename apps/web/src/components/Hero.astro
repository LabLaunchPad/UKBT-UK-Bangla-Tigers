---
// Hero — re-art-directed. One dominant visual idea: "WE'RE NOT JUST A TEAM."
// Legacy two-row structure (heading+social, community+CTA cards) replaced
// with editorial composition: large statement, supporting copy, primary CTA.
// Social links become a subtle horizontal row, not a full column.
import Button from './Button.astro';

interface Props {
  taglineShort: string;
  social: { platform: string; url: string }[];
}
const { taglineShort, social } = Astro.props;

const icons: Record<string, string> = {
  facebook: 'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12',
  instagram: 'M12 2c2.7 0 3.1 0 4.1.1 1.1 0 1.8.2 2.5.5.7.3 1.2.6 1.7 1.1.5.5.9 1 1.1 1.7.3.7.5 1.4.5 2.5.1 1 .1 1.4.1 4.1s0 3.1-.1 4.1c0 1.1-.2 1.8-.5 2.5-.3.7-.6 1.2-1.1 1.7-.5.5-1 .9-1.7 1.1-.7.3-1.4.5-2.5.5-1 .1-1.4.1-4.1.1s-3.1 0-4.1-.1c-1.1 0-1.8-.2-2.5-.5-.7-.3-1.2-.6-1.7-1.1-.5-.5-.9-1-1.1-1.7-.3-.7-.5-1.4-.5-2.5C2 15.1 2 14.7 2 12s0-3.1.1-4.1c0-1.1.2-1.8.5-2.5.3-.7.6-1.2 1.1-1.7.5-.5 1-.9 1.7-1.1.7-.3 1.4-.5 2.5-.5C8.9 2 9.3 2 12 2Zm0 2c-2.6 0-3 0-4 .1-.9 0-1.4.2-1.7.3-.4.2-.7.4-1 .7-.3.3-.5.6-.7 1-.1.3-.3.8-.3 1.7C4.2 9 4.2 9.4 4.2 12s0 3 .1 4c0 .9.2 1.4.3 1.7.2.4.4.7.7 1 .3.3.6.5 1 .7.3.1.8.3 1.7.3 1 .1 1.4.1 4 .1s3 0 4-.1c.9 0 1.4-.2 1.7-.3.4-.2.7-.4 1-.7.3-.3.5-.6.7-1 .1-.3.3-.8.3-1.7.1-1 .1-1.4.1-4s0-3-.1-4c0-.9-.2-1.4-.3-1.7-.2-.4-.4-.7-.7-1-.3-.3-.6-.5-1-.7-.3-.1-.8-.3-1.7-.3-1-.1-1.4-.1-4-.1Zm0 3.5A4.5 4.5 0 1 1 12 16a4.5 4.5 0 0 1 0-9Zm0 2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Zm4.8-2.7a1 1 0 1 1 0 2.1 1 1 0 0 1 0-2.1Z',
  tiktok: 'M14 2h3a5 5 0 0 0 5 5v3a8 8 0 0 1-5-1.7V15a6 6 0 1 1-6-6c.3 0 .7 0 1 .1v3.1a3 3 0 1 0 2 2.8V2Z',
  x: 'M3 3l7.4 9.5L3.2 21H6l5.7-6.4L16 21h5l-7.7-9.9L20.6 3h-2.8l-5.3 5.9L8 3H3Z',
};
---

<div class="ukbt-hero">
  <div class="ukbt-container ukbt-hero__inner">
    <div class="ukbt-hero__content">
      <img
        src="/brand/crest-512.png"
        width="100"
        height="137"
        alt=""
        class="ukbt-hero__crest"
        fetchpriority="high"
      />
      <h1 class="ukbt-hero__headline">
        We're not just<br />a team.
      </h1>
      <p class="ukbt-hero__tagline">{taglineShort}</p>
      <div class="ukbt-hero__actions">
        <Button label="Join the Club" href="/join" variant="primary" />
      </div>
      <ul class="ukbt-hero__social">
        {
          social.map((s) => (
            <li>
              <a href={s.url} aria-label={`UK Bangla Tigers on ${s.platform}`} rel="me noopener">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor">
                  <path d={icons[s.platform]} />
                </svg>
                <span>{s.platform}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<style>
  .ukbt-hero {
    background: var(--ukbt-color-surface-inverse);
    color: var(--ukbt-color-surface-inverse-foreground);
    --ukbt-color-focus-ring: var(--ukbt-color-brand-accent);
  }
  .ukbt-hero__inner {
    display: flex;
    align-items: center;
    min-height: clamp(20rem, 60vh, 34rem);
    padding-block: var(--ukbt-space-section-padding);
  }
  .ukbt-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ukbt-space-4);
    max-width: 48rem;
  }
  .ukbt-hero__crest {
    height: 5rem;
    width: auto;
    opacity: 0.6;
  }
  .ukbt-hero__headline {
    font-family: var(--ukbt-font-family-heading);
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    font-weight: 700;
    line-height: 1.05;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .ukbt-hero__tagline {
    font-family: var(--ukbt-font-family-heading);
    color: var(--ukbt-color-brand-accent);
    font-size: var(--ukbt-font-size-2);
    font-weight: 600;
    margin: 0;
  }
  .ukbt-hero__actions {
    margin-top: var(--ukbt-space-2);
  }
  .ukbt-hero :global(.ukbt-button--primary) {
    background: var(--ukbt-color-brand-accent);
    border-color: var(--ukbt-color-brand-accent);
    color: var(--ukbt-color-brand-accent-contrast);
  }
  .ukbt-hero :global(.ukbt-button--primary:hover) {
    background: var(--ukbt-color-brand-accent-hover);
    border-color: var(--ukbt-color-brand-accent-hover);
  }
  .ukbt-hero__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ukbt-space-4);
    list-style: none;
    margin: var(--ukbt-space-4) 0 0 0;
    padding: 0;
  }
  .ukbt-hero__social a {
    display: inline-flex;
    align-items: center;
    gap: var(--ukbt-space-1);
    color: inherit;
    text-decoration: none;
    font-size: var(--ukbt-font-size-0);
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }
  .ukbt-hero__social a:hover {
    opacity: 1;
    color: var(--ukbt-color-brand-accent);
  }

  @media (max-width: 767px) {
    .ukbt-hero__headline {
      font-size: clamp(2rem, 1.2rem + 4vw, 3rem);
    }
  }
</style>
