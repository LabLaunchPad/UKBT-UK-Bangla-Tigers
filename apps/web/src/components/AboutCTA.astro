---
// Mirrors the reference's "Membership CTA Section" 2-column card grammar
// (`.card-membership-cta.cta-content` + `.cta-benefit`). The reference's
// specific membership-perks bullet list (priority booking, discounted
// coaching, etc.) has no UKBT equivalent evidence and is not invented —
// this card carries only evidenced content: a join CTA and the real
// social handles.
import Button from './Button.astro';

interface Social {
  platform: string;
  url: string;
}
interface Props {
  social: Social[];
}
const { social } = Astro.props;
---

<div class="ukbt-about-cta">
  <div class="ukbt-about-cta__content">
    <h3>Follow the Tigers</h3>
    <p>Stay with every match, signing, and tournament as it happens.</p>
    <Button label="Join the Club" href="/contact" variant="primary" />
  </div>
  <div class="ukbt-about-cta__benefit">
    <p class="ukbt-about-cta__benefit-lede">
      Stay connected across every platform we play on.
    </p>
    <ul class="ukbt-about-cta__social">
      {
        social.map((s) => (
          <li>
            <a href={s.url} rel="me noopener">{s.platform}</a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  /* .row.row-cols-xl-2: 2-column CTA card pair */
  .ukbt-about-cta {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--ukbt-space-6);
  }
  .ukbt-about-cta__content,
  .ukbt-about-cta__benefit {
    border-radius: var(--ukbt-radius-lg);
    padding: var(--ukbt-space-6);
  }
  /* .cta-content: accent-forward */
  .ukbt-about-cta__content {
    background: var(--ukbt-color-brand-accent);
    color: var(--ukbt-color-brand-accent-contrast);
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-3);
    align-items: flex-start;
  }
  .ukbt-about-cta__content h3 {
    margin: 0;
  }
  .ukbt-about-cta__content p {
    margin: 0;
  }
  /* .cta-benefit: neutral surface */
  .ukbt-about-cta__benefit {
    background: var(--ukbt-color-surface-inverse);
    color: var(--ukbt-color-surface-inverse-foreground);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--ukbt-space-4);
  }
  .ukbt-about-cta__benefit-lede {
    margin: 0;
    font-size: var(--ukbt-font-size-1);
  }
  .ukbt-about-cta__social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ukbt-space-4);
  }
  .ukbt-about-cta__social a {
    color: var(--ukbt-color-brand-accent);
    text-decoration: none;
    text-transform: capitalize;
    font-weight: var(--ukbt-font-weight-bold);
  }
  .ukbt-about-cta__social a:hover {
    text-decoration: underline;
  }

  .ukbt-about-cta :global(.ukbt-button--primary) {
    background: var(--ukbt-color-brand-primary);
    border-color: var(--ukbt-color-brand-primary);
    color: var(--ukbt-color-brand-primary-contrast);
  }
  .ukbt-about-cta :global(.ukbt-button--primary:hover) {
    background: var(--ukbt-color-brand-primary-hover);
    border-color: var(--ukbt-color-brand-primary-hover);
  }

  @media (max-width: 767px) {
    .ukbt-about-cta {
      grid-template-columns: 1fr;
    }
  }
</style>
