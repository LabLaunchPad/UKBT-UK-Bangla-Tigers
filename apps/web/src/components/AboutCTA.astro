---
// AboutCTA — re-art-directed. Clean editorial CTA, not two-column card.
// Statement + CTA + social links as a typographic row.
import Button from './Button.astro';

interface Social {
  platform: string;
  url: string;
}
interface Props {
  social: Social[];
}
const { social } = Astro.props;
const primarySocial = social[0];
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<div class="ukbt-about-cta">
  <div class="ukbt-about-cta__content">
    <h2 class="ukbt-about-cta__headline">Follow the Tigers</h2>
    <p class="ukbt-about-cta__body">Every tournament, every result — straight from the club.</p>
    {primarySocial && (
      <Button
        label={`Follow on ${capitalize(primarySocial.platform)}`}
        href={primarySocial.url}
        variant="primary"
      />
    )}
  </div>
  <div class="ukbt-about-cta__social">
    <span class="ukbt-about-cta__social-label">Also on</span>
    <ul class="ukbt-about-cta__social-list">
      {
        social.map((s) => (
          <li>
            <a href={s.url} rel="me noopener">{capitalize(s.platform)}</a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .ukbt-about-cta {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-gap-5);
    border-top: 3px solid var(--ukbt-color-brand-accent);
    padding-top: var(--ukbt-space-6);
  }
  .ukbt-about-cta__content {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-3);
    align-items: flex-start;
    max-width: 36rem;
  }
  .ukbt-about-cta__headline {
    font-family: var(--ukbt-font-family-heading);
    font-size: clamp(1.8rem, 1.2rem + 2vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .ukbt-about-cta__body {
    margin: 0;
    font-size: var(--ukbt-font-size-2);
    color: var(--ukbt-color-neutral-700);
  }
  .ukbt-about-cta :global(.ukbt-button--primary) {
    background: var(--ukbt-color-brand-primary);
    border-color: var(--ukbt-color-brand-primary);
    color: var(--ukbt-color-brand-primary-contrast);
  }
  .ukbt-about-cta :global(.ukbt-button--primary:hover) {
    background: var(--ukbt-color-brand-primary-hover);
    border-color: var(--ukbt-color-brand-primary-hover);
  }
  .ukbt-about-cta__social {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-2);
  }
  .ukbt-about-cta__social-label {
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-700);
  }
  .ukbt-about-cta__social-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ukbt-space-4);
  }
  .ukbt-about-cta__social-list a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--ukbt-color-brand-primary);
    text-decoration: none;
    font-weight: var(--ukbt-font-weight-bold);
    font-size: var(--ukbt-font-size-0);
  }
  .ukbt-about-cta__social-list a:hover {
    text-decoration: underline;
  }
</style>
