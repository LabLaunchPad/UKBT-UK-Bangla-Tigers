---
// UKBT-original — no Adelux equivalent exists (a padel-club template has
// no player-profile grammar). Portrait-led: the captain's client-supplied
// portrait beside the facts. Falls back to the crest only when no photo
// is provided.
interface Fact {
  label: string;
  value: string;
}
interface Props {
  name: string;
  role: string;
  facts: Fact[];
  /** Portrait src. When omitted, the club crest is shown instead. */
  photo?: string;
  /** standard: profile row. athlete: larger portrait for the captain-page
     hero (capped well under the 640px source width — never upscaled). */
  layout?: 'standard' | 'athlete';
  /** One concise identity line under the role (page-composed from gated
     values). Rendered only when provided. */
  identityLine?: string;
  /** C2: omit the eyebrow pill where the page banner already carries the
     identity (club-captain). Default true preserves current behavior;
     single-consumer component, so no other route is affected either way. */
  showEyebrow?: boolean;
}
const { name, role, facts, photo, layout = 'standard', identityLine, showEyebrow = true } = Astro.props;
import SubHeading from './SubHeading.astro';
---

<div class:list={['ukbt-profile-header', layout === 'athlete' && 'ukbt-profile-header--athlete']}>
  {/*
    Pair to CaptainSpotlight's portrait (same photo, same aspect):
    players/home card → captain profile across navigation. Name lives
    only in the photo branch — the crest fallback must never claim it.
  */}
  {photo ? (
    <img
      src={photo}
      width="240"
      height="320"
      alt={`${name}, ${role}`}
      class="ukbt-profile-header__photo"
      fetchpriority="high"
      transition:name="ukbt-captain-portrait"
    />
  ) : (
      <img
        src="/brand/crest-512.png"
        width="120"
        height="165"
        alt="UK Bangla Tigers crest"
        class="ukbt-profile-header__crest"
      />
    )
  }
  <div class="ukbt-profile-header__content">
    {showEyebrow && <SubHeading label="Club Captain" />}
    <h2 class="ukbt-profile-header__name">{name}</h2>
    <p class="ukbt-profile-header__role">{role}</p>
    {identityLine && <p class="ukbt-profile-header__identity">{identityLine}</p>}
    <dl class="ukbt-profile-header__facts">
      {
        facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</div>

<style>
  .ukbt-profile-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--ukbt-space-8);
  }
  .ukbt-profile-header__crest {
    height: 9rem;
    width: auto;
    flex: none;
  }
  /* Portrait: fixed 3:4 frame, face kept via object-position top.
     Same card radius as the site's editorial imagery (ClubIntro). */
  .ukbt-profile-header__photo {
    width: 15rem;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top;
    border-radius: var(--ukbt-radius-ref-card);
    flex: none;
  }
  /* Flex-row overflow guard: without min-width:0 the content column
     refuses to shrink and long fact values blow out 320–767px. */
  .ukbt-profile-header__content {
    min-width: 0;
  }
  .ukbt-profile-header__name {
    margin: var(--ukbt-space-2) 0 0 0;
  }
  .ukbt-profile-header__role {
    /* Gold-on-white fails AA (2.33:1, EV-20260826-029) — use the navy
       primary for accent emphasis on this light/default surface instead. */
    color: var(--ukbt-color-brand-primary);
    font-family: var(--ukbt-font-family-heading);
    font-weight: var(--ukbt-font-weight-bold);
    margin: 0 0 var(--ukbt-space-4) 0;
  }
  .ukbt-profile-header__identity {
    font-size: var(--ukbt-font-size-1);
    color: var(--ukbt-color-neutral-700);
    margin: calc(-1 * var(--ukbt-space-2)) 0 var(--ukbt-space-4) 0;
    max-width: 40rem;
  }
  /* Athlete hero: portrait-led at a larger frame + larger name. The
     20rem frame (320px) stays well under the 640px source — no upscale.
     DOM order (image → identity → metadata) already gives the mobile
     stacking the brief requires, so no order overrides here. */
  .ukbt-profile-header--athlete .ukbt-profile-header__photo {
    width: 20rem;
  }
  .ukbt-profile-header--athlete .ukbt-profile-header__name {
    font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3rem);
  }
  .ukbt-profile-header__facts {
    display: grid;
    /* minmax(0,1fr), not auto: auto columns don't shrink, so long values
       overflow narrow viewports before the 767px single-column collapse. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ukbt-space-2) var(--ukbt-space-6);
    margin: 0;
  }
  .ukbt-profile-header__facts dt {
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-700);
  }
  .ukbt-profile-header__facts dd {
    margin: 0;
    font-weight: var(--ukbt-font-weight-bold);
  }

  @media screen and (max-width: 767px) {
    .ukbt-profile-header {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }
    /* Athlete frame collapses exactly like the standard one (the desktop
       20rem rule is higher-specificity and would otherwise hold 320px
       wide inside a 320px viewport). Merged selectors: identical
       declarations, one rule. */
    .ukbt-profile-header__photo,
    .ukbt-profile-header--athlete .ukbt-profile-header__photo {
      width: 100%;
      max-width: 20rem;
      height: 24rem;
    }
    .ukbt-profile-header__facts {
      grid-template-columns: 1fr;
    }
  }
</style>
