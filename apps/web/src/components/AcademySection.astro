---
// AcademySection — re-art-directed. Full-width navy, typographic statistics.
// Clean counters with accent borders, no cards, no decorative elements.
import SectionHeader from './SectionHeader.astro';

interface Counter {
  value: string;
  label: string;
}
interface Props {
  tagline: string;
  counters: Counter[];
  /** Section header copy. Defaults preserve the homepage Development band. */
  eyebrow?: string;
  heading?: string;
  /** inverse: navy band (homepage). default: light surface, navy numerals
     (gold text fails contrast on light — gold stays decorative only). */
  tone?: 'inverse' | 'default';
}
const {
  tagline,
  counters,
  eyebrow = 'Development',
  heading = 'Not Only a Team — an Institute for Learning',
  tone = 'inverse',
} = Astro.props;
---

<div class:list={['ukbt-academy', tone === 'default' && 'ukbt-academy--default']}>
  <SectionHeader
    eyebrow={eyebrow}
    heading={heading}
    lede={tagline}
    rule="primary"
    inverse={tone === 'inverse'}
  />
  <div class="ukbt-academy__counters">
    {
      counters.map((c) => (
        <div class="ukbt-academy__counter">
          <span class="ukbt-academy__value">{c.value}</span>
          <span class="ukbt-academy__label">{c.label}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .ukbt-academy {
    display: flex;
    flex-direction: column;
  }
  .ukbt-academy__counters {
    display: flex;
    gap: var(--ukbt-space-gap-100);
    margin-top: var(--ukbt-space-8);
  }
  .ukbt-academy__counter {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-1);
    flex: 1;
    border-top: 2px solid var(--ukbt-color-brand-accent);
    padding-top: var(--ukbt-space-3);
  }
  .ukbt-academy__value {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-5);
    font-weight: 700;
    line-height: 1;
    color: var(--ukbt-color-brand-accent);
  }
  .ukbt-academy__label {
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-100);
  }
  /* Light-surface stats band (About/Captain reuse): same grammar, navy
     numerals + body-tone labels. The gold top-border stays — decorative,
     never text, so the brand contrast rule is untouched. */
  .ukbt-academy--default .ukbt-academy__value {
    color: var(--ukbt-color-brand-primary);
  }
  .ukbt-academy--default .ukbt-academy__label {
    color: var(--ukbt-color-neutral-700);
  }

  @media screen and (max-width: 767px) {
    .ukbt-academy__counters {
      flex-direction: column;
      gap: var(--ukbt-space-6);
    }
  }
</style>
