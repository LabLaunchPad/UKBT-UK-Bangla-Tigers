---
// AcademySection — re-art-directed. Full-width navy, typographic statistics.
// Clean counters with accent borders, no cards, no decorative elements.
import SectionHeader from './SectionHeader.astro';

interface Counter {
  value: string;
  label: string;
}
interface Props {
  tagline: string;
  counters: Counter[];
}
const { tagline, counters } = Astro.props;
---

<div class="ukbt-academy">
  <SectionHeader
    eyebrow="Development"
    heading="Not Only a Team — an Institute for Learning"
    lede={tagline}
    rule="primary"
    inverse={true}
  />
  <div class="ukbt-academy__counters">
    {
      counters.map((c) => (
        <div class="ukbt-academy__counter">
          <span class="ukbt-academy__value">{c.value}</span>
          <span class="ukbt-academy__label">{c.label}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .ukbt-academy {
    display: flex;
    flex-direction: column;
  }
  .ukbt-academy__counters {
    display: flex;
    gap: var(--ukbt-space-gap-100);
    margin-top: var(--ukbt-space-8);
  }
  .ukbt-academy__counter {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-1);
    flex: 1;
    border-top: 2px solid var(--ukbt-color-brand-accent);
    padding-top: var(--ukbt-space-3);
  }
  .ukbt-academy__value {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-5);
    font-weight: 700;
    line-height: 1;
    color: var(--ukbt-color-brand-accent);
  }
  .ukbt-academy__label {
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-300);
  }

  @media screen and (max-width: 767px) {
    .ukbt-academy__counters {
      flex-direction: column;
      gap: var(--ukbt-space-6);
    }
  }
</style>
