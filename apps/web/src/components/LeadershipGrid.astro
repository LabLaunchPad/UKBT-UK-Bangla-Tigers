---
// Mirrors the reference's "Team Section" layout grammar
// (`.team-content-wrapper`: flex row, gap 100px — sticky title column +
// card grid). Each roster card carries its member's cleared portrait
// (owner direction 2026-09-11, EV-20260910-001 + EV-20260911-001);
// the test in about.spec.ts pins exactly these files. No other
// leadership imagery is permitted.
interface Leader {
  name: string;
  role: string;
  photo: Image;
}
interface Image {
  src: string;
  alt: string;
  width: number;
  height: number;
}
interface Props {
  leaders: Leader[];
  narrative?: string[];
}
const { leaders, narrative } = Astro.props;
import SubHeading from './SubHeading.astro';
---

{narrative && (
  <div class="ukbt-leadership__narrative">
    {narrative.map((p) => <p>{p}</p>)}
  </div>
)}
<div class="ukbt-leadership">
  <div class="ukbt-leadership__cards">
    {
      leaders.map((l, i) => (
        <div class:list={['ukbt-leadership__card', i === 0 && 'ukbt-leadership__card--feature']}>
          <img
            src={l.photo.src}
            width={l.photo.width}
            height={l.photo.height}
            alt={l.photo.alt}
            loading="lazy"
            class="ukbt-leadership__card-photo"
          />
          <div class="ukbt-leadership__card-body">
            <h4>{l.name}</h4>
            <p>{l.role}</p>
          </div>
        </div>
      ))
    }
  </div>
  <div class="ukbt-leadership__title">
    <SubHeading label="Our Leadership" />
    <h2>Meet the People Behind the Tigers</h2>
    <p>
      The committee and playing leadership guiding UK Bangla Tigers on and
      off the pitch. The full committee roster is still being confirmed.
    </p>
  </div>
</div>

<style>
  /* .team-content-wrapper: flex row, gap 100px, align-items start */
  .ukbt-leadership {
    display: flex;
    flex-direction: row;
    gap: var(--ukbt-space-gap-100);
    align-items: flex-start;
  }
  .ukbt-leadership__cards {
    flex: 0 0 55%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ukbt-space-4);
  }
  /* Bento roster (owner direction 2026-09-11, full-picture treatment):
     photos bleed edge-to-edge across the card top (overflow clips the
     top corners to the card radius), bodies share one rhythm below.
     First card (Founder, semantic lead) spans two rows with a tall
     crop; the pair stack beside it. This supersedes the A5 orphan
     rule — the bento owns composition now, so that rule is deleted
     below rather than left to fight the span. */
  .ukbt-leadership__card {
    background: var(--ukbt-color-surface-alt);
    border-radius: var(--ukbt-radius-ref-card);
    overflow: hidden;
    text-align: center;
    border-top: 3px solid var(--ukbt-color-brand-accent);
    display: flex;
    flex-direction: column;
  }
  .ukbt-leadership__card--feature {
    grid-row: span 2;
  }
  /* Roster portraits: DEFINITE heights only. Intrinsic-driven sizing
     (flex-fill, aspect-ratio) fails here: inside indefinite grid rows
     the photos fall back to intrinsic heights (measured 1200px+
     boxes, faces sliced by cover) instead of transferring ratio.
     Fixed heights sidestep the trap entirely; the feature photo fills
     its definite spanned area via flex. Face kept via top crop. */
  .ukbt-leadership__card-photo {
    display: block;
    width: 100%;
    height: 16rem;
    flex: none;
    object-fit: cover;
    object-position: top;
  }
  .ukbt-leadership__card--feature .ukbt-leadership__card-photo {
    height: auto;
    flex: 1 1 auto;
    min-height: 20rem;
  }
  .ukbt-leadership__card-body {
    padding: var(--ukbt-space-4) var(--ukbt-space-4) var(--ukbt-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-1);
  }
  .ukbt-leadership__card-body h4 {
    margin: 0;
    font-size: var(--ukbt-font-size-2);
    font-weight: var(--ukbt-font-weight-bold);
  }
  .ukbt-leadership__card p {
    margin: 0;
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-700);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .ukbt-leadership__title {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-2);
  }
  .ukbt-leadership__title h2 {
    margin: 0;
  }
  .ukbt-leadership__title p:last-child {
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-size-0);
  }
  /* Management narrative (About Phase 1): full-width editorial intro
     above the cards row. */
  .ukbt-leadership__narrative {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-3);
    max-width: 48rem;
    margin-bottom: var(--ukbt-space-6);
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-size-1);
  }
  .ukbt-leadership__narrative p {
    margin: 0;
  }
  /* A3: opening paragraph takes the lede size (size-2, as in
     ClubIntro/AboutCTA) so gated copy scans as intro + detail. */
  .ukbt-leadership__narrative p:first-child {
    font-size: var(--ukbt-font-size-2);
  }
  /* Reference `.team-content-wrapper` at <=1025px: column-reverse, 50px gap. */  @media screen and (max-width: 1025px) {
    .ukbt-leadership {
      flex-direction: column-reverse;
      gap: var(--ukbt-space-gap-5);
    }
    .ukbt-leadership__cards {
      flex: 1 1 auto;
      width: 100%;
    }
  }
  @media screen and (max-width: 767px) {
    .ukbt-leadership__cards {
      grid-template-columns: 1fr;
    }
    /* Mobile bento: single column with compact fixed crops — ratio
       boxes fall into the same intrinsic-height trap, so definite
       heights here too. Span reset so the feature card can't strand
       a row. */
    .ukbt-leadership__card--feature {
      grid-row: auto;
    }
    .ukbt-leadership__card-photo,
    .ukbt-leadership__card--feature .ukbt-leadership__card-photo {
      flex: none;
      height: 12rem;
      min-height: 0;
    }
  }
</style>
