---
// Mirrors the reference's "Team Section" layout grammar
// (`.team-content-wrapper`: flex row, gap 100px — sticky title column +
// card grid) with the reference's photo-overlay `.card-team` style
// deliberately NOT ported: cards here are text-only (name + role), never
// a placeholder photo standing in for a real person.
//
// Owner-authorised exception (About Phase 1, EV-20260910-001): exactly
// two identified photographs render in this section — the
// management-team graphic (all three leaders identified, baked-in
// labels match the gated name/role strings) and Sayem Rahman's
// supplied portrait (identity confirmed against the graphic). No other
// leadership imagery is permitted; the test in about.spec.ts pins this.
interface Leader {
  name: string;
  role: string;
}
interface Image {
  src: string;
  alt: string;
  width: number;
  height: number;
}
interface Props {
  leaders: Leader[];
  graphic?: Image;
  spotlight?: { name: string; role: string; bio: string[]; photo: Image };
  narrative?: string[];
}
const { leaders, graphic, spotlight, narrative } = Astro.props;
import SubHeading from './SubHeading.astro';
---

{narrative && (
  <div class="ukbt-leadership__narrative">
    {narrative.map((p) => <p>{p}</p>)}
  </div>
)}
<div class="ukbt-leadership">
  <div class="ukbt-leadership__cards">
    {
      leaders.map((l) => (
        <div class="ukbt-leadership__card">
          <h4>{l.name}</h4>
          <p>{l.role}</p>
        </div>
      ))
    }
  </div>
  <div class="ukbt-leadership__title">
    <SubHeading label="Our Leadership" />
    <h2>Meet the People Behind the Tigers</h2>
    <p>
      The committee and playing leadership guiding UK Bangla Tigers on and
      off the pitch. The full committee roster is still being confirmed.
    </p>
  </div>
</div>
{
  graphic && (
    <figure class="ukbt-leadership__graphic">
      <img
        src={graphic.src}
        width={graphic.width}
        height={graphic.height}
        alt={graphic.alt}
        loading="lazy"
      />
    </figure>
  )
}
{
  spotlight && (
    <div class="ukbt-leadership__spotlight">
      <img
        src={spotlight.photo.src}
        width={spotlight.photo.width}
        height={spotlight.photo.height}
        alt={spotlight.photo.alt}
        loading="lazy"
      />
      <div class="ukbt-leadership__spotlight-text">
        <span class="ukbt-leadership__spotlight-name">{spotlight.name}</span>
        <span class="ukbt-leadership__spotlight-role">{spotlight.role}</span>
        {spotlight.bio.map((p) => (
          <p class="ukbt-leadership__spotlight-bio">{p}</p>
        ))}
      </div>
    </div>
  )
}

<style>
  /* .team-content-wrapper: flex row, gap 100px, align-items start */
  .ukbt-leadership {
    display: flex;
    flex-direction: row;
    gap: var(--ukbt-space-gap-100);
    align-items: flex-start;
  }
  .ukbt-leadership__cards {
    flex: 0 0 55%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ukbt-space-4);
  }
  .ukbt-leadership__card {
    background: var(--ukbt-color-surface-alt);
    border-radius: var(--ukbt-radius-lg);
    padding: var(--ukbt-space-6) var(--ukbt-space-4);
    text-align: center;
    border-top: 3px solid var(--ukbt-color-brand-accent);
  }
  .ukbt-leadership__card h4 {
    margin: 0 0 var(--ukbt-space-1) 0;
    font-size: var(--ukbt-font-size-1);
  }
  .ukbt-leadership__card p {
    margin: 0;
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-700);
  }
  .ukbt-leadership__title {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-2);
  }
  .ukbt-leadership__title h2 {
    margin: 0;
  }
  .ukbt-leadership__title p:last-child {
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-size-0);
  }
  /* Management narrative (About Phase 1): full-width editorial intro
     above the cards row. */
  .ukbt-leadership__narrative {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-3);
    max-width: 48rem;
    margin-bottom: var(--ukbt-space-6);
    color: var(--ukbt-color-neutral-700);
    font-size: var(--ukbt-font-size-1);
  }
  .ukbt-leadership__narrative p {
    margin: 0;
  }
  /* Owner-authorised leadership imagery (About Phase 1): the
     management-team graphic, full width below the row, capped so the
     portrait-oriented creative never dominates the section. */
  .ukbt-leadership__graphic {
    margin: var(--ukbt-space-8) auto 0 auto;
    max-width: 30rem;
  }
  .ukbt-leadership__graphic img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--ukbt-radius-ref-card);
  }
  /* Vice-chairman spotlight: portrait + name/role + distilled bio. */
  .ukbt-leadership__spotlight {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: var(--ukbt-space-4);
    margin-top: var(--ukbt-space-6);
    padding: var(--ukbt-space-4);
    background: var(--ukbt-color-surface-alt);
    border-radius: var(--ukbt-radius-ref-card);
    border-top: 3px solid var(--ukbt-color-brand-accent);
    max-width: 44rem;
  }
  .ukbt-leadership__spotlight img {
    display: block;
    width: 5rem;
    height: 5rem;
    object-fit: cover;
    border-radius: var(--ukbt-radius-ref-card);
    flex: none;
  }
  .ukbt-leadership__spotlight-text {
    display: flex;
    flex-direction: column;
    gap: var(--ukbt-space-1);
  }
  .ukbt-leadership__spotlight-name {
    font-family: var(--ukbt-font-family-heading);
    font-size: var(--ukbt-font-size-1);
    font-weight: var(--ukbt-font-weight-bold);
  }
  .ukbt-leadership__spotlight-role {
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-700);
  }
  .ukbt-leadership__spotlight-bio {
    margin: var(--ukbt-space-2) 0 0 0;
    font-size: var(--ukbt-font-size-0);
    color: var(--ukbt-color-neutral-700);
  }

  /* Reference `.team-content-wrapper` at <=1025px: column-reverse, 50px gap. */  @media screen and (max-width: 1025px) {
    .ukbt-leadership {
      flex-direction: column-reverse;
      gap: var(--ukbt-space-gap-5);
    }
    .ukbt-leadership__cards {
      flex: 1 1 auto;
      width: 100%;
    }
  }
  @media screen and (max-width: 767px) {
    .ukbt-leadership__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
